api/node_modules
apprenant/node_modules
admin/node_modules
front/node_modules
front.old/nodeModules
node_modules

# Aucun fichier d'environnement ne rejoint le dépôt. Les valeurs vivent dans
# Infisical ; le dépôt ne porte que le contrat, dans les fichiers `env.example`.
.env
.env.*
.env-*
**/.env
**/.env.*
**/.env-*

# Couvre aussi les noms hérités : `.deploy.env`, `deployment.env`, `env.demo`.
*.env
**/*.env
env.*
**/env.*

*.credentials
.infisical-token

# Deux exceptions, aujourd'hui suivies. Sans ces négations, un `git add -A`
# les désindexerait.
#   - api/.env.test        : configuration de la suite de tests, sans valeur réelle
#   - front/.env.production : configuration publique compilée dans le bundle Vite
!api/.env.test
!front/.env.production
!**/env.example
**/.DS_Store
tmp
/front/tmp/npm-cache/_cacache/content-v2/sha512/00/1d
/api/tmp
/front/tmp
certs/
fixtures-test.ts

# Runtime-generated database and activity dumps.
# Le jeu de démonstration fait exception : il est versionné, l'instance de
# démonstration étant reconstruite à partir de lui.
/api/dumps/*
!/api/dumps/.gitkeep
!/api/dumps/demo/
/dumps/
