pipeline {
    agent any

   tools {
        nodejs 'NodeJS-22'
    }
    environment {
        //SCANNER_HOME = tool 'sonar-scanner'
        //SONAR_TOKEN = credentials('sonar-token')
        //SONAR_HOST_URL = 'http://51.15.183.215:9000/'

        HOST = credentials('FNP_HOST')
        USER = credentials('FNP_USER')
        SSH_CRED = credentials('FNP_SSH')
        TARGET = credentials('FNP_TARGET')
        BRANCH_NAME = "${env.GIT_BRANCH.split('/').last()}"
        PORT = credentials('FNP_PORT')
        
    }

    stages {
        stage("Checkout") {
            steps {
                checkout scm
                script {
                    echo "Checked out branch: ${BRANCH_NAME}"
                }
            }
        }

        stage("Build App") {
            steps {
                script {
                    echo "Building application..."
                    sh 'npm run install'
                    sh 'npm run generate'
                    sh 'npm run deploy'
                }
            }
        }

        stage("Deploy to FNP") {
            steps {
                script {
                    echo "Deploying to FNP..."

                    echo "Deployment details:"
                    echo "Host: ${HOST}"
                    echo "User: ${USER}"
                    echo "Target: ${TARGET}"


                    echo("pinging ${HOST}..." + ping "${HOST}" + " -c 4")
                    //sh "scp -o StrictHostKeyChecking=no -i ${SSH_CRED} -P ${PORT} ${USER}@${HOST}:/home/${USER}/${TARGET}"
                    sh "echo 'Deployment to FNP completed successfully!'"

                }
            }
        }
    }}
      