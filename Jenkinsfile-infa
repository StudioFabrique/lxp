pipeline {
    agent any

   tools {
        nodejs 'NodeJS-22'
    }
    environment {
        SCANNER_HOME = tool 'SonarQube Scanner'
        //SONAR_TOKEN = credentials('SONAR-JENKINS-TOKEN')
        //SONAR_QUBE_HOST = 'http://192.168.10.101:9000/'        
    }

    stages {
        stage("Checkout") {
            steps {
                checkout scm
                script {
                def branchName = env.GIT_BRANCH?.split('/')?.last()
                echo "Checked out branch: ${branchName}"
                }
            }
        }

        stage("Sonar Qube") {
            steps {
                withCredentials([
                    string(credentialsId: "SONAR-JENKINS-TOKEN", variable: "SONAR_TOKEN"),
                    string(credentialsId: "SONAR_QUBE_HOST", variable: "SONAR_QUBE_HOST")
                ]) {
                    sh '''
                        ${SCANNER_HOME}/bin/sonar-scanner \
                        -Dsonar.projectKey=lxp  \
                        -Dsonar.projectName=lxp \
                        -Dsonar.host.url=$SONAR_QUBE_HOST \
                        -Dsonar.login=$SONAR_TOKEN
                    '''
                }
            }
        }

        stage("Build App") {
            steps {
                script {
                    echo "Building application..."
                    sh 'npm run install'
                    sh 'npm run generate'
                    sh 'npm run deploy'
                }
            }
        }
    

        stage("Deploying to INFA") {

            steps {
                withCredentials([
                    file(credentialsId: 'INFA_ENV', variable: 'ENV_FILE'),
                    string(credentialsId: 'INFA_HOST', variable: 'HOST'),
                    string(credentialsId: 'INFA_USER', variable: 'USER'),
                    string(credentialsId: 'INFA_PORT', variable: 'PORT'),
                    string(credentialsId: 'INFA_TARGET', variable: 'TARGET'),
                    sshUserPrivateKey(credentialsId: 'INFA_SSH', keyFileVariable: 'SSH_CRED')
                ]) {
                    sh '''
                        echo "🔧 Setting environment variables from $ENV_FILE..."
                        
                        # Inject .env in workspace
                        cp $ENV_FILE ./api/dist/.env

                        echo "📡 Deploying to FNP..."
                        echo "🔎 Pinging $HOST..."

                        ping -c 4 $HOST
                    '''
                    
                    sh '''
                        scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT -r ./api/dist $USER@$HOST:/home/$USER/$TARGET/
                    '''

                    sh '''
                        scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT -r ./api/prisma $USER@$HOST:/home/$USER/$TARGET/dist/
                    '''

                    sh '''
                        scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT docker-compose.yml $USER@$HOST:/home/$USER/$TARGET/
                    '''

                    sh '''
                        scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT ./api/package.json $USER@$HOST:/home/$USER/$TARGET/dist/
                    '''

                    sh '''
                        scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT ./api/package-lock.json $USER@$HOST:/home/$USER/$TARGET/dist/
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET/dist && npm ci --omit=dev"
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET/dist && npx prisma generate"  
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET && docker network create lxp_network || true"
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET && docker compose down || true && docker compose up -d"
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET && docker image prune -f"
                    '''

                    echo "✅ Deployment to INFA completed successfully!"
        
                }
            }
        }
    }
}


