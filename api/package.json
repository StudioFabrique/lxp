{
  "name": "lxp-api",
  "version": "1.0.0",
  "description": "api pour le projet lxp",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "wait-for-db": "node check-test-db.ts",
    "docker:up": "cd tests && docker compose up -d && cd ..",
    "docker:down": "cd tests && docker compose down && cd ..",
    "test:setup": "npm run prisma-generate && npm run docker:up && npm run wait-for-db && dotenv -e .env.test -- prisma db migrate && dotenv -e .env.test -- node tests/fixtures/mongo.ts && dotenv -e .env.test -- node tests/fixtures/postgres.ts",
    "test:run": "echo '🚀 Starting Jest...' && NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --clearCache && NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand",
    "test:cleanup": "npm run docker:down",
    "test": "npm run test:cleanup && npm run test:setup && npm run test:run && npm run test:cleanup",
    "build": "prisma contract emit && tsc --project tsconfig.build.json",
    "typecheck": "prisma contract emit && tsc --project ./ --noEmit",
    "start:dev": "NODE_ENV=development node --watch src/server.ts",
    "start:prod": "NODE_ENV=production node dist/src/server.js",
    "prisma-generate": "prisma contract emit",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --verbose --no-cache --runInBand",
    "test:list": "jest --listTests",
    "generate-activation-key": "node src/scripts/generate-activation-key.ts",
    "send-root-invitation": "node src/scripts/send-root-invitation.ts",
    "demo:seed": "node src/scripts/demo-seed.ts",
    "notify-triggers": "docker compose exec -T db-pg sh -c 'psql -v ON_ERROR_STOP=1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < src/scripts/andria_notify_triggers.sql"
  },
  "author": "studio@step.eco",
  "license": "ISC",
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "bcrypt": "^6.0.0",
    "chalk": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "prisma": "8.0.0-rc.15",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.1",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260704.1": true
  }
}
