{
  "name": "lxp-api",
  "version": "1.0.0",
  "description": "api pour le projet lxp",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "wait-for-db": "node check-test-db.ts",
    "docker:up": "cd tests && docker compose up -d && cd ..",
    "docker:down": "cd tests && docker compose down && cd ..",
    "test:setup": "npm run docker:up && npm run wait-for-db && dotenv -e .env.test -- npx prisma migrate deploy && dotenv -e .env.test -- node src/fixtures.ts && dotenv -e .env.test -- node src/fixtures-prisma-test.ts",
    "test:run": "echo '\ud83d\ude80 Starting Jest...' && NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --clearCache && NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand",
    "test:cleanup": "npm run docker:down",
    "test": "npm run test:cleanup && npm run test:setup && npm run test:run && npm run test:cleanup",
    "build": "prisma generate && tsc --project tsconfig.build.json",
    "typecheck": "prisma generate && tsc --project ./ --noEmit",
    "start:dev": "NODE_ENV=development node --watch src/server.ts",
    "start:prod": "NODE_ENV=production node dist/src/server.js",
    "prisma-generate": "npx prisma generate",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --verbose --no-cache --runInBand",
    "test:list": "jest --listTests",
    "generate-activation-key": "node src/scripts/generate-activation-key.ts",
    "demo:seed": "node src/scripts/demo-seed.ts",
    "notify-triggers": "docker compose exec -T db-pg sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < src/scripts/andria_notify_triggers.sql"
  },
  "author": "studio@step.eco",
  "license": "ISC",
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^6.1.5",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.2",
    "prisma": "^6.12.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.5.4",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.0.5",
    "pg": "^8.16.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "sharp@0.32.6": true,
    "unrs-resolver@1.12.2": true
  }
}
