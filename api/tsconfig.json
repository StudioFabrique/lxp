{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "types": ["node", "jest"],
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "prisma.config.ts"],
  "exclude": ["dist", "node_modules", "prisma.config.ts"]
}
