{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "prisma.config.ts", "generated/prisma/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
