generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Accomplishment {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String
  accomplishedAt       DateTime @default(now())
  hasBeenCongratulated Boolean  @default(false)
  studentId            Int
  showToOtherStudent   Boolean  @default(false)
  courseId             Int?
  course               Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Activity {
  id                 Int                @id @default(autoincrement())
  title              String?
  type               String
  order              Int
  url                String
  lessonId           Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  authorId           Int
  author             Admin              @relation(fields: [authorId], references: [id], onDelete: SetDefault)
  lesson             Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resourceActivities ResourceActivity[]
  quizzes            Quiz[]
  activitiesRead     ActivityRead[]
  duplicationIndex   Int                @default(0)
}

model Admin {
  id              Int             @id @default(autoincrement())
  idMdb           String
  activities      Activity[]
  courses         Course[]
  formation       Formation[]
  lessons         Lesson[]
  medias          Mediatheque[]
  modules         Module[]
  parcours        Parcours[]
  bonusActivities BonusActivity[]
  resources       Resource[]
}

model BonusActivity {
  id                      Int                     @id @default(autoincrement())
  title                   String?
  type                    String
  order                   Int
  url                     String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  admin                   Admin                   @relation(fields: [adminId], references: [id], onDelete: SetDefault)
  adminId                 Int
  resource                Resource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId              Int
  resourceBonusActivities ResourceBonusActivity[]
}

model BonusSkill {
  id          Int                   @id @default(autoincrement())
  description String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  badge       String?
  parcoursId  Int
  parcours    Parcours              @relation(fields: [parcoursId], references: [id])
  modules     BonusSkillsOnModule[]
}

model BonusSkillsOnModule {
  bonusSkillId Int
  moduleId     Int
  bonusSkill   BonusSkill @relation(fields: [bonusSkillId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([bonusSkillId, moduleId])
}

model Contact {
  id        Int                  @id @default(autoincrement())
  idMdb     String               @unique
  role      String
  email     String?
  phone     String?              @default("Non renseigné")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  courses   ContactsOnCourse[]
  modules   ContactsOnModule[]
  parcours  ContactsOnParcours[]
}

model ContactsOnCourse {
  contactId Int
  courseId  Int
  contact   Contact @relation(fields: [contactId], references: [id])
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([contactId, courseId])
}

model ContactsOnModule {
  contactId Int
  moduleId  Int
  contact   Contact @relation(fields: [contactId], references: [id])
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([contactId, moduleId])
}

model ContactsOnParcours {
  parcoursId Int
  contactId  Int
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parcours   Parcours @relation(fields: [parcoursId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([parcoursId, contactId])
}

model Course {
  id               Int                @id @default(autoincrement())
  title            String
  description      String?
  image            Bytes?
  virtualClass     String?
  visibility       Boolean?
  scenario         Boolean            @default(true)
  dates            Json[]
  order            Int
  isPublished      Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  author           String
  adminId          Int
  courseSlug       String?
  accomplishments  Accomplishment[]
  contacts         ContactsOnCourse[]
  admin            Admin              @relation(fields: [adminId], references: [id], onDelete: SetDefault)
  moduleId         Int
  module           Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  tags             TagsOnCourse[]
  quizzes          Quiz[]
  coursesRead      CourseRead[]
  duplicationIndex Int                @default(0)
}

model Formation {
  id          Int               @id @default(autoincrement())
  title       String            @unique
  description String?
  code        String?
  level       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  adminId     Int
  admin       Admin             @relation(fields: [adminId], references: [id])
  parcours    Parcours[]
  tags        TagsOnFormation[]
}

model Group {
  id       Int                @id @default(autoincrement())
  idMdb    String
  parcours GroupsOnParcours[]
}

model GroupsOnParcours {
  groupId    Int
  parcoursId Int
  group      Group    @relation(fields: [groupId], references: [id])
  parcours   Parcours @relation(fields: [parcoursId], references: [id])

  @@id([groupId, parcoursId])
}

model Lesson {
  id               Int            @id @default(autoincrement())
  title            String
  description      String
  modalite         String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  author           String
  adminId          Int
  courseId         Int
  tagId            Int
  order            Int
  isPublished      Boolean        @default(false)
  visibility       Boolean        @default(false)
  activities       Activity[]
  admin            Admin          @relation(fields: [adminId], references: [id], onDelete: SetDefault)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag              Tag            @relation(fields: [tagId], references: [id])
  lessonRating     LessonRating[]
  lessonsRead      LessonRead[]
  duplicationIndex Int            @default(0)
}

model LessonRating {
  id        Int     @id @default(autoincrement())
  rating    Int
  lessonId  Int
  studentId Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model LessonRead {
  id           Int       @id @default(autoincrement())
  beganAt      DateTime  @default(now())
  lastOpenedAt DateTime  @default(now())
  finishedAt   DateTime?
  readTimeMs   Int       @default(0)
  lessonId     Int
  studentId    Int
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, lastOpenedAt])
}

model Mediatheque {
  id        Int      @id @default(autoincrement())
  type      String
  url       String
  name      String
  authorId  Int
  size      Int
  used      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    Admin    @relation(fields: [authorId], references: [id], onDelete: SetDefault)
}

model Module {
  id               Int                   @id @default(autoincrement())
  title            String
  description      String?
  quizInstructions String?
  image            Bytes?
  thumb            Bytes?
  duration         Int?
  rating           Float?
  minDate          DateTime?
  maxDate          DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  author           String
  adminId          Int
  parcoursId       Int
  duplicationIndex Int                   @default(0)
  admin            Admin                 @relation(fields: [adminId], references: [id], onDelete: SetDefault)
  parcours         Parcours              @relation(fields: [parcoursId], references: [id], onDelete: Cascade)
  contacts         ContactsOnModule[]
  courses          Course[]
  bonusSkills      BonusSkillsOnModule[]
  quizzes          Quiz[]
  modulesRead      ModuleRead[]
}

model Objective {
  id          Int      @id @default(autoincrement())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parcoursId  Int
  parcours    Parcours @relation(fields: [parcoursId], references: [id])
}

model OpenBadge {
  id        Int      @id @default(autoincrement())
  creator   String
  image     Bytes
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parcours {
  id               Int                  @id @default(autoincrement())
  title            String               @unique
  description      String?
  startDate        DateTime?            @default(dbgenerated("date_trunc('day'::text, (now() + '1 day'::interval))"))
  endDate          DateTime?            @default(dbgenerated("date_trunc('day'::text, (now() + '2 mons'::interval))"))
  degree           String?
  image            Bytes?
  thumb            Bytes?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  author           String
  visibility       Boolean              @default(false)
  adminId          Int
  formationId      Int
  virtualClass     String?
  isPublished      Boolean              @default(false)
  bonusSkills      BonusSkill[]
  contacts         ContactsOnParcours[]
  groups           GroupsOnParcours[]
  objectives       Objective[]
  admin            Admin                @relation(fields: [adminId], references: [id], onDelete: SetDefault)
  formation        Formation            @relation(fields: [formationId], references: [id])
  skills           SkillsOnParcours[]
  tags             TagsOnParcours[]
  modules          Module[]
  duplicationIndex Int                  @default(0)
}

model Resource {
  id              Int               @id @default(autoincrement())
  title           String
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  author          String
  adminId         Int
  imageUrl        String?
  admin           Admin             @relation(fields: [adminId], references: [id], onDelete: SetDefault)
  tags            TagsOnResources[]
  bonusActivities BonusActivity[]
}

model ResourceActivity {
  id         Int      @id @default(autoincrement())
  label      String
  order      Int
  url        String
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ResourceBonusActivity {
  id              Int           @id @default(autoincrement())
  label           String
  order           Int
  url             String
  bonusActivityId Int
  bonusActivity   BonusActivity @relation(fields: [bonusActivityId], references: [id], onDelete: Cascade)
}

model Skill {
  id          Int                @id @default(autoincrement())
  description String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  badge       String?
  parcours    SkillsOnParcours[]
}

model SkillsOnParcours {
  skillId    Int
  parcoursId Int
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  skill      Skill    @relation(fields: [skillId], references: [id])

  @@id([skillId, parcoursId])
}

model Student {
  id              Int              @id @default(autoincrement())
  idMdb           String           @unique
  accomplishments Accomplishment[]
  lessonRating    LessonRating[]
  lessonsRead     LessonRead[]
  modulesRead     ModuleRead[]
  coursesRead     CourseRead[]
  activitiesRead  ActivityRead[]
  quizzes         Quiz[]
  quizAttempts    QuizAttempt[]
}

model Tag {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  color      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  lessons    Lesson[]
  courses    TagsOnCourse[]
  formations TagsOnFormation[]
  parcours   TagsOnParcours[]
  resources  TagsOnResources[]
}

model TagsOnCourse {
  tagId    Int
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([tagId, courseId])
}

model TagsOnFormation {
  tagId       Int
  formationId Int
  formation   Formation @relation(fields: [formationId], references: [id])
  tag         Tag       @relation(fields: [tagId], references: [id])

  @@id([tagId, formationId])
}

model TagsOnParcours {
  tagId      Int
  parcoursId Int
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([tagId, parcoursId])
}

model TagsOnResources {
  tagId      Int
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([tagId, resourceId])
}

model Teacher {
  id    Int    @id @default(autoincrement())
  idMdb String
}

model Authorization {
  id       Int    @id @default(autoincrement())
  role     String
  action   String
  resource String
}

model Quiz {
  id    Int    @id @default(autoincrement())
  title String
  type  String // Ex: "ending_course", "preliminary", "random"

  moduleId   Int?
  module     Module?   @relation(fields: [moduleId], references: [id])
  activityId Int?
  activity   Activity? @relation(fields: [activityId], references: [id])
  courseId   Int?
  course     Course?   @relation(fields: [courseId], references: [id])

  questions QuizQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attempts QuizAttempt[]
}

model QuizQuestion {
  id     Int   @id @default(autoincrement())
  quizId Int?
  quiz   Quiz? @relation(fields: [quizId], references: [id], onDelete: Cascade)

  externalId       String?
  type             String // "mcq", "true_false", "matching", "ordering"
  difficulty       String   @default("medium")
  prompt           String
  explanationTrue  String?
  explanationWrong String?
  tags             String[]

  data Json

  contentHash String? @unique

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  quizQuestionReports QuizQuestionReport[]
  quizAnswers         QuizAnswer[]
}

model QuizQuestionReport {
  id             Int           @id @default(autoincrement())
  quizQuestionId Int?
  quizQuestion   QuizQuestion? @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  commentaire    String?
}

/// Suivi de lecture d'un module par un apprenant.
/// `readTimeMs` cumule le temps réellement passé sur le contenu (heartbeats),
/// `finishedAt - beganAt` ne peut pas servir de durée : il s'étale sur plusieurs jours.
model ModuleRead {
  id           Int       @id @default(autoincrement())
  beganAt      DateTime  @default(now())
  lastOpenedAt DateTime  @default(now())
  finishedAt   DateTime?
  readTimeMs   Int       @default(0)
  moduleId     Int
  studentId    Int
  module       Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([moduleId, studentId])
  @@index([studentId, lastOpenedAt])
}

/// Suivi de lecture d'un cours par un apprenant.
model CourseRead {
  id           Int       @id @default(autoincrement())
  beganAt      DateTime  @default(now())
  lastOpenedAt DateTime  @default(now())
  finishedAt   DateTime?
  readTimeMs   Int       @default(0)
  courseId     Int
  studentId    Int
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, lastOpenedAt])
}

/// Suivi de lecture d'une activité par un apprenant.
model ActivityRead {
  id           Int       @id @default(autoincrement())
  beganAt      DateTime  @default(now())
  lastOpenedAt DateTime  @default(now())
  finishedAt   DateTime?
  readTimeMs   Int       @default(0)
  activityId   Int
  studentId    Int
  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId])
  @@index([studentId, lastOpenedAt])
}

/// Une passation de quiz par un apprenant.
/// `origin` distingue notamment le quiz formatif "je veux me tester" (self_test).
model QuizAttempt {
  id             Int          @id @default(autoincrement())
  quizId         Int
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  origin         String
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  totalQuestions Int          @default(0)
  correctAnswers Int          @default(0)
  answers        QuizAnswer[]

  @@index([studentId, startedAt])
}

/// Réponse d'un apprenant à une question de quiz.
/// `isCorrect` est toujours calculé côté serveur, jamais fourni par le client.
model QuizAnswer {
  id             Int          @id @default(autoincrement())
  attemptId      Int
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizQuestionId Int
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  isCorrect      Boolean
  userAnswer     Json
  answeredAt     DateTime     @default(now())

  @@unique([attemptId, quizQuestionId])
  @@index([attemptId])
}
