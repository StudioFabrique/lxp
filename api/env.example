# LXP API — développement local

# L'API Node tourne sur l'hôte et les bases sont exposées par api/docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5500/lxp"
MONGO_LOCAL_URL="mongodb://root:root@localhost:27000/lxp?authSource=admin"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lxp

MONGO_ADMIN_USERNAME=root
MONGO_ADMIN_PASSWORD=root
MONGO_DATABASE=lxp

# En développement, ia-lxp écoute sur l'hôte. Dans le Compose de production,
# utiliser l'adresse interne DOCKER_IA_API_BASE_URL=http://ai:8000.
DOCKER_IA_API_BASE_URL="http://localhost:8000"
DOCKER_IA_AUTH_SECRET="change-me"

# Base pgvector dédiée au service IA.
ANDRIA_POSTGRES_USER=andria
ANDRIA_POSTGRES_PASSWORD=andria
ANDRIA_POSTGRES_DB=lxp_ai

# Ces URL sont celles utilisées depuis les conteneurs du Compose de production.
ANDRIA_AI_DB_URL="postgresql://andria:andria@db-ai:5432/lxp_ai"
LXP_DB_URL="postgresql://postgres:postgres@db-pg:5432/lxp"

LXP_PUBLIC_BASE="http://localhost:3000"

MISTRAL_STUDENT_API_KEY=
MISTRAL_CONTENT_API_KEY=
MISTRAL_MODEL=mistral-small-latest

SECRET_KEY="change-me"
DEV_BYPASS_AUTH=true

QUIZ_TEMPERATURE=0.5
QUIZ_MAX_TOKENS=1200
QUIZ_MAX_ATTEMPTS=3
QUIZ_PARALLEL_SLOTS=3
QUIZ_MIN_PROMPT_LEN=12
QUIZ_MIN_EXPLANATION_LEN=10
DB_INGEST_MIN_WORDS=20

# Sécurité et configuration applicative
REGISTER_SECRET="change-me-activation-secret"
SECRET="change-me-session-secret"

ENVIRONMENT=development
FRONT_URL="http://localhost:5173/"
PORT=3000

# Utilisés uniquement par le Compose et le pipeline de déploiement pour les
# volumes persistants du serveur. Sans effet lors d'un lancement local de l'API.
SSH_USER=deploy
SSH_TARGET=lxp

# SMTP
EMAIL="example@test.fr"
PASSWORD=
SMTP="smtp.example.com"
SMTP_EMAIL="example@test.fr"
SMTP_PORT=587
FROM="Andria Admin <example@test.fr>"

# Unsplash API credentials
UNSPLASH_ACCESS_KEY=
