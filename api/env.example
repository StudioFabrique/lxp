# LXP API — développement local

# L'API Node tourne sur l'hôte et les bases sont exposées par api/docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5500/lxp"
MONGO_LOCAL_URL="mongodb://root:root@localhost:27000/lxp?authSource=admin"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lxp

MONGO_ADMIN_USERNAME=root
MONGO_ADMIN_PASSWORD=root
MONGO_DATABASE=lxp

# En développement, ia-lxp écoute sur l'hôte. Dans le Compose de production,
# utiliser l'adresse interne DOCKER_IA_API_BASE_URL=http://ai:8000.
DOCKER_IA_API_BASE_URL="http://localhost:8000"
DOCKER_IA_AUTH_SECRET="secret-key"

# Base pgvector dédiée au service IA.
ANDRIA_POSTGRES_USER=andria
ANDRIA_POSTGRES_PASSWORD=andria
ANDRIA_POSTGRES_DB=lxp_ai

# Sécurité et configuration applicative
REGISTER_SECRET="change-me-activation-secret"
SECRET="change-me-session-secret"

ENVIRONMENT=development
FRONT_URL="http://localhost:5173/"
PORT=3000

# SMTP
EMAIL="example@test.fr"
PASSWORD=
SMTP="smtp.example.com"
SMTP_EMAIL="example@test.fr"
SMTP_PORT=587
FROM="Andria Admin <example@test.fr>"

# Unsplash API credentials
UNSPLASH_ACCESS_KEY=
