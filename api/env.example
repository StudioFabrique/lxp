# LXP API : développement local

# L'API Node tourne sur l'hôte et les bases sont exposées par api/docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5500/lxp"
MONGO_LOCAL_URL="mongodb://root:root@localhost:27000/lxp?authSource=admin"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lxp

MONGO_ADMIN_USERNAME=root
MONGO_ADMIN_PASSWORD=root
MONGO_DATABASE=lxp

# En développement, ia-lxp écoute sur l'hôte. Dans le Compose de production,
# utiliser l'adresse interne DOCKER_IA_API_BASE_URL=http://ai:8000.
DOCKER_IA_API_BASE_URL="http://localhost:8000"
DOCKER_IA_AUTH_SECRET="secret-key"

# Coupe les fonctions IA sans déployer le service. `isAiDisabled()` dans
# api/src/config/config.ts est vrai dès que ce drapeau ou `DEMO_MODE` l'est.
# Le front lit la même décision par `GET /v1/demo/config` : il n'a pas de
# variable équivalente. Vite intègre ses variables au moment du build.
DISABLE_AI_FEATURES=false

# Base pgvector dédiée au service IA.
ANDRIA_POSTGRES_USER=andria
ANDRIA_POSTGRES_PASSWORD=andria
ANDRIA_POSTGRES_DB=lxp_ai

# Sécurité et configuration applicative
REGISTER_SECRET="change-me-activation-secret"
# Durée de validité des clés créées par generate-activation-key, en minutes.
ROOT_ACTIVATION_TOKEN_TTL_MINUTES=30
SECRET="change-me-session-secret"

# Mode démonstration. Sur `true`, l'API refuse toute écriture et expose
# l'ouverture d'une session de démonstration. Réservé à l'instance dédiée :
# ne jamais l'activer sur une instance portant des données réelles.
DEMO_MODE=false
# Adresse de l'instance de démonstration, annoncée par les autres instances.
DEMO_URL=
# Adresse de retour quand un visiteur quitte la démonstration.
DEMO_EXIT_URL=
# Clé de signature des défis anti-robot de la page /demo.
ALTCHA_HMAC_KEY=
# Comptes empruntés par les visiteurs de la démonstration.
DEMO_ADMIN_EMAIL=
DEMO_STUDENT_EMAIL=

ENVIRONMENT=development
FRONT_URL="http://localhost:5173/"
PORT=3000

# Mailer (SMTP)
MAILER_EMAIL="example@test.fr"
MAILER_PASSWORD=
MAILER_SMTP="smtp.example.com"
MAILER_DEV_RECIPIENT="example@test.fr"
MAILER_SMTP_PORT=587
MAILER_FROM="Andria Admin <example@test.fr>"

# Unsplash API credentials
UNSPLASH_ACCESS_KEY=
