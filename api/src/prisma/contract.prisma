// Prisma 8 PostgreSQL contract. Timestamp strings remain directly parseable by
// JavaScript while avoiding a global Temporal dependency on Node.js 24.

model Accomplishment {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String
  accomplishedAt       TimestamptzString @default(now())
  hasBeenCongratulated Boolean  @default(false)
  studentId            Int
  showToOtherStudent   Boolean  @default(false)
  courseId             Int?
  course               Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("Accomplishment")
}

model Activity {
  id                 Int                @id @default(autoincrement())
  title              String?
  type               String
  order              Int
  url                String
  lessonId           Int
  createdAt          TimestamptzString           @default(now())
  updatedAt          temporal.updatedAtString()
  authorId           Int
  author             Admin              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  lesson             Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resourceActivities ResourceActivity[]
  quizzes            Quiz[]
  activitiesRead     ActivityRead[]
  duplicationIndex   Int                @default(0)

  @@map("Activity")
}

model Admin {
  id              Int             @id @default(autoincrement())
  idMdb           String
  activities      Activity[]
  courses         Course[]
  formation       Formation[]
  lessons         Lesson[]
  medias          Mediatheque[]
  modules         Module[]
  parcours        Parcours[]
  bonusActivities BonusActivity[]
  resources       Resource[]

  @@map("Admin")
}

model BonusActivity {
  id                      Int                     @id @default(autoincrement())
  title                   String?
  type                    String
  order                   Int
  url                     String
  createdAt               TimestamptzString                @default(now())
  updatedAt               temporal.updatedAtString()
  admin                   Admin                   @relation(fields: [adminId], references: [id], onDelete: Restrict)
  adminId                 Int
  resource                Resource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId              Int
  resourceBonusActivities ResourceBonusActivity[]

  @@map("BonusActivity")
}

model BonusSkill {
  id          Int                   @id @default(autoincrement())
  description String
  createdAt   TimestamptzString              @default(now())
  updatedAt   temporal.updatedAtString()
  badge       String?
  parcoursId  Int
  parcours    Parcours              @relation(fields: [parcoursId], references: [id])
  modules     BonusSkillsOnModule[]

  @@map("BonusSkill")
}

model BonusSkillsOnModule {
  bonusSkillId Int
  moduleId     Int
  bonusSkill   BonusSkill @relation(fields: [bonusSkillId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([bonusSkillId, moduleId])

  @@map("BonusSkillsOnModule")
}

model Contact {
  id        Int                  @id @default(autoincrement())
  idMdb     String               @unique
  role      String
  email     String?
  phone     String?              @default("Non renseigné")
  createdAt TimestamptzString             @default(now())
  updatedAt temporal.updatedAtString()
  courses   ContactsOnCourse[]
  modules   ContactsOnModule[]
  parcours  ContactsOnParcours[]

  @@map("Contact")
}

model ContactsOnCourse {
  contactId Int
  courseId  Int
  contact   Contact @relation(fields: [contactId], references: [id])
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([contactId, courseId])

  @@map("ContactsOnCourse")
}

model ContactsOnModule {
  contactId Int
  moduleId  Int
  contact   Contact @relation(fields: [contactId], references: [id])
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([contactId, moduleId])

  @@map("ContactsOnModule")
}

model ContactsOnParcours {
  parcoursId Int
  contactId  Int
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parcours   Parcours @relation(fields: [parcoursId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([parcoursId, contactId])

  @@map("ContactsOnParcours")
}

model Course {
  id                  Int                @id @default(autoincrement())
  title               String
  description         String?
  image               Bytes?
  virtualClass        String?
  visibility          Boolean?
  scenario            Boolean            @default(true)
  dates               Json[]
  calendarInitialized Boolean            @default(false)
  calendarColor       String             @default(dbgenerated("(ARRAY['primary'::text, 'secondary'::text, 'accent'::text, 'neutral'::text, 'info'::text, 'success'::text, 'warning'::text, 'error'::text])[((floor((random() * (8)::double precision)) + (1)::double precision))::integer]"))
  order               Int
  isPublished         Boolean            @default(false)
  createdAt           TimestamptzString           @default(now())
  updatedAt           temporal.updatedAtString()
  author              String
  adminId             Int
  courseSlug          String?
  accomplishments     Accomplishment[]
  contacts            ContactsOnCourse[]
  admin               Admin              @relation(fields: [adminId], references: [id], onDelete: Restrict)
  moduleId            Int
  module              Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons             Lesson[]
  tags                TagsOnCourse[]
  quizzes             Quiz[]
  coursesRead         CourseRead[]
  assignment          CourseAssignment?
  duplicationIndex    Int                @default(0)

  @@map("Course")
}

/// Devoir obligatoire affiché comme dernière étape d'un cours.
model CourseAssignment {
  id            Int                         @id @default(autoincrement())
  courseId      Int                         @unique
  dueAt         TimestamptzString
  maxScore      Float                       @default(20)
  rubricVisible Boolean                     @default(true)
  instructions  String
  createdAt     TimestamptzString                    @default(now())
  updatedAt     temporal.updatedAtString()
  course        Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  criteria      CourseAssignmentCriterion[]
  files         CourseAssignmentFile[]
  submissions   AssignmentSubmission[]

  @@map("CourseAssignment")
}

model CourseAssignmentCriterion {
  id           Int                        @id @default(autoincrement())
  assignmentId Int
  label        String
  weight       Float
  order        Int
  assignment   CourseAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scores       AssignmentCriterionScore[]

  @@index([assignmentId, order])

  @@map("CourseAssignmentCriterion")
}

model CourseAssignmentFile {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  originalName String
  storedName   String           @unique
  mimeType     String
  size         Int
  createdAt    TimestamptzString         @default(now())
  assignment   CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])

  @@map("CourseAssignmentFile")
}

model AssignmentSubmission {
  id              Int                        @id @default(autoincrement())
  assignmentId    Int
  studentId       Int
  text            String?
  submittedAt     TimestamptzString?
  grade           Float?
  feedback        String?
  gradedAt        TimestamptzString?
  gradedBy        String?
  createdAt       TimestamptzString                   @default(now())
  updatedAt       temporal.updatedAtString()
  assignment      CourseAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files           AssignmentSubmissionFile[]
  criterionScores AssignmentCriterionScore[]

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])

  @@map("AssignmentSubmission")
}

model AssignmentSubmissionFile {
  id           Int                  @id @default(autoincrement())
  submissionId Int
  originalName String
  storedName   String               @unique
  mimeType     String
  size         Int
  createdAt    TimestamptzString             @default(now())
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])

  @@map("AssignmentSubmissionFile")
}

model AssignmentCriterionScore {
  id           Int                       @id @default(autoincrement())
  submissionId Int
  criterionId  Int
  score        Float
  submission   AssignmentSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion    CourseAssignmentCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])

  @@map("AssignmentCriterionScore")
}

model Formation {
  id          Int               @id @default(autoincrement())
  title       String            @unique
  description String?
  code        String?
  level       String
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
  adminId     Int
  admin       Admin             @relation(fields: [adminId], references: [id])
  parcours    Parcours[]
  tags        TagsOnFormation[]
  studentAssessments StudentFormationAssessment[]
  availabilityNotifications ContentAvailabilityNotification[]

  @@map("Formation")
}

model Group {
  id       Int                @id @default(autoincrement())
  idMdb    String
  parcours GroupsOnParcours[]

  @@map("Group")
}

model GroupsOnParcours {
  groupId    Int @unique
  parcoursId Int
  group      Group    @relation(fields: [groupId], references: [id])
  parcours   Parcours @relation(fields: [parcoursId], references: [id])

  @@id([groupId, parcoursId])

  @@map("GroupsOnParcours")
}

model Lesson {
  id               Int            @id @default(autoincrement())
  title            String
  description      String
  modalite         String
  createdAt        TimestamptzString       @default(now())
  updatedAt        temporal.updatedAtString()
  author           String
  adminId          Int
  courseId         Int
  tagId            Int
  order            Int
  visibility       Boolean        @default(false)
  activities       Activity[]
  admin            Admin          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag              Tag            @relation(fields: [tagId], references: [id])
  lessonRating     LessonRating[]
  lessonsRead      LessonRead[]
  duplicationIndex Int            @default(0)

  @@map("Lesson")
}

model LessonRating {
  id        Int     @id @default(autoincrement())
  rating    Int
  lessonId  Int
  studentId Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("LessonRating")
}

model LessonRead {
  id           Int       @id @default(autoincrement())
  beganAt      TimestamptzString  @default(now())
  lastOpenedAt TimestamptzString  @default(now())
  finishedAt   TimestamptzString?
  readTimeMs   Int       @default(0)
  lessonId     Int
  studentId    Int
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, lastOpenedAt])

  @@map("LessonRead")
}

model Mediatheque {
  id        Int      @id @default(autoincrement())
  type      String
  url       String
  name      String
  authorId  Int
  size      Int
  used      Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  author    Admin    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("Mediatheque")
}

model Module {
  id               Int                   @id @default(autoincrement())
  title            String
  description      String?
  quizInstructions String?
  image            Bytes?
  thumb            Bytes?
  duration         Int?
  rating           Float?
  minDate          TimestamptzString?
  maxDate          TimestamptzString?
  createdAt        TimestamptzString              @default(now())
  updatedAt        temporal.updatedAtString()
  author           String
  adminId          Int
  parcoursId       Int
  duplicationIndex Int                   @default(0)
  admin            Admin                 @relation(fields: [adminId], references: [id], onDelete: Restrict)
  parcours         Parcours              @relation(fields: [parcoursId], references: [id], onDelete: Cascade)
  contacts         ContactsOnModule[]
  courses          Course[]
  bonusSkills      BonusSkillsOnModule[]
  quizzes          Quiz[]
  modulesRead      ModuleRead[]

  @@map("Module")
}

model Objective {
  id          Int      @id @default(autoincrement())
  description String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  parcoursId  Int
  parcours    Parcours @relation(fields: [parcoursId], references: [id])

  @@map("Objective")
}

model OpenBadge {
  id        Int      @id @default(autoincrement())
  creator   String
  image     Bytes
  url       String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("OpenBadge")
}

model Parcours {
  id               Int                  @id @default(autoincrement())
  title            String               @unique
  description      String?
  startDate        TimestamptzString?            @default(dbgenerated("date_trunc('day'::text, (now() + '1 day'::interval))"))
  endDate          TimestamptzString?            @default(dbgenerated("date_trunc('day'::text, (now() + '2 mons'::interval))"))
  degree           String?
  image            Bytes?
  thumb            Bytes?
  createdAt        TimestamptzString             @default(now())
  updatedAt        temporal.updatedAtString()
  author           String
  adminId          Int
  formationId      Int
  virtualClass     String?
  isPublished      Boolean              @default(false)
  bonusSkills      BonusSkill[]
  contacts         ContactsOnParcours[]
  groups           GroupsOnParcours[]
  objectives       Objective[]
  admin            Admin                @relation(fields: [adminId], references: [id], onDelete: Restrict)
  formation        Formation            @relation(fields: [formationId], references: [id])
  skills           SkillsOnParcours[]
  tags             TagsOnParcours[]
  modules          Module[]
  duplicationIndex Int                  @default(0)

  @@map("Parcours")
}

model Resource {
  id              Int               @id @default(autoincrement())
  title           String
  description     String?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()
  author          String
  adminId         Int
  imageUrl        String?
  admin           Admin             @relation(fields: [adminId], references: [id], onDelete: Restrict)
  tags            TagsOnResources[]
  bonusActivities BonusActivity[]

  @@map("Resource")
}

model ResourceActivity {
  id         Int      @id @default(autoincrement())
  label      String
  order      Int
  url        String
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("ResourceActivity")
}

model ResourceBonusActivity {
  id              Int           @id @default(autoincrement())
  label           String
  order           Int
  url             String
  bonusActivityId Int
  bonusActivity   BonusActivity @relation(fields: [bonusActivityId], references: [id], onDelete: Cascade)

  @@map("ResourceBonusActivity")
}

model Skill {
  id          Int                @id @default(autoincrement())
  description String             @unique
  createdAt   TimestamptzString           @default(now())
  updatedAt   temporal.updatedAtString()
  badge       String?
  parcours    SkillsOnParcours[]

  @@map("Skill")
}

model SkillsOnParcours {
  skillId    Int
  parcoursId Int
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  skill      Skill    @relation(fields: [skillId], references: [id])

  @@id([skillId, parcoursId])

  @@map("SkillsOnParcours")
}

model Student {
  id                    Int                    @id @default(autoincrement())
  idMdb                 String                 @unique
  accomplishments       Accomplishment[]
  lessonRating          LessonRating[]
  lessonsRead           LessonRead[]
  modulesRead           ModuleRead[]
  coursesRead           CourseRead[]
  activitiesRead        ActivityRead[]
  quizzes               Quiz[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  contentReadCredits    ContentReadCredit[]
  learningProfile       StudentLearningProfile?
  formationAssessments  StudentFormationAssessment[]
  availabilityNotifications ContentAvailabilityNotification[]

  @@map("Student")
}

/// Déclarations globales de l'apprenant, indépendantes d'une formation.
model StudentLearningProfile {
  id                 Int      @id @default(autoincrement())
  studentId          Int      @unique
  pace               String?
  preferences        String[]
  onboardingStatus   String   @default("not_started")
  currentStep        String   @default("")
  onboardingVersion  Int      @default(1)
  initialCompletedAt TimestamptzString?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("StudentLearningProfile")
}

/// Auto-évaluation déclarative, unique pour une formation donnée.
model StudentFormationAssessment {
  id          Int       @id @default(autoincrement())
  studentId   Int
  formationId Int
  level       String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([studentId, formationId])
  @@index([formationId])
  @@map("StudentFormationAssessment")
}

/// Outbox durable pour l'annonce de la première disponibilité d'une formation.
model ContentAvailabilityNotification {
  id                Int       @id @default(autoincrement())
  studentId         Int
  formationId       Int
  status            String    @default("pending")
  attemptCount      Int       @default(0)
  nextAttemptAt     TimestamptzString @default(now())
  lastAttemptAt     TimestamptzString?
  sentAt            TimestamptzString?
  lastError         String?
  suppressionReason String?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formation         Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([studentId, formationId])
  @@index([status, nextAttemptAt], map: "AvailabilityNotification_due")
  @@map("ContentAvailabilityNotification")
}

/// Marqueurs idempotents des initialisations applicatives liées aux données.
model SystemJobState {
  key         String @id
  completedAt TimestamptzString @default(now())

  @@map("SystemJobState")
}

/// Intervalles réellement crédités ; les anciens compteurs ne sont pas rétrodatés.
model ContentReadCredit {
  id        Int      @id @default(autoincrement())
  studentId Int
  type      String
  contentId Int
  from      TimestamptzString
  to        TimestamptzString
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type, to])

  @@map("ContentReadCredit")
}

model Tag {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  color      String
  createdBy  String?
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()
  lessons    Lesson[]
  courses    TagsOnCourse[]
  formations TagsOnFormation[]
  parcours   TagsOnParcours[]
  resources  TagsOnResources[]

  @@index([createdBy])

  @@map("Tag")
}

model TagsOnCourse {
  tagId    Int
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([tagId, courseId])

  @@map("TagsOnCourse")
}

model TagsOnFormation {
  tagId       Int
  formationId Int
  formation   Formation @relation(fields: [formationId], references: [id])
  tag         Tag       @relation(fields: [tagId], references: [id])

  @@id([tagId, formationId])

  @@map("TagsOnFormation")
}

model TagsOnParcours {
  tagId      Int
  parcoursId Int
  addedBy    String?
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([tagId, parcoursId])
  @@index([addedBy])

  @@map("TagsOnParcours")
}

model TagsOnResources {
  tagId      Int
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([tagId, resourceId])

  @@map("TagsOnResources")
}

model Teacher {
  id    Int    @id @default(autoincrement())
  idMdb String

  @@map("Teacher")
}

model Authorization {
  id       Int    @id @default(autoincrement())
  role     String
  action   String
  resource String

  @@map("Authorization")
}

model Quiz {
  id    Int    @id @default(autoincrement())
  title String
  type  String // Ex: "ending_course", "preliminary", "random"

  moduleId   Int?
  module     Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  activityId Int?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  courseId   Int?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attempts QuizAttempt[]

  @@map("Quiz")
}

model QuizQuestion {
  id     Int   @id @default(autoincrement())
  quizId Int?
  quiz   Quiz? @relation(fields: [quizId], references: [id], onDelete: Cascade)

  externalId       String?
  type             String // "mcq", "true_false", "matching", "ordering"
  difficulty       String   @default("medium")
  prompt           String
  explanationTrue  String?
  explanationWrong String?
  tags             String[]

  data Json

  contentHash String? @unique

  createdAt           TimestamptzString             @default(now())
  updatedAt           temporal.updatedAtString()
  quizQuestionReports QuizQuestionReport[]
  quizAnswers         QuizAnswer[]

  @@map("QuizQuestion")
}

model QuizQuestionReport {
  id             Int           @id @default(autoincrement())
  quizQuestionId Int?
  quizQuestion   QuizQuestion? @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  commentaire    String?

  @@map("QuizQuestionReport")
}

/// Suivi de lecture d'un module par un apprenant.
/// `readTimeMs` cumule le temps réellement passé sur le contenu (heartbeats),
/// `finishedAt - beganAt` ne peut pas servir de durée : il s'étale sur plusieurs jours.
model ModuleRead {
  id           Int       @id @default(autoincrement())
  beganAt      TimestamptzString  @default(now())
  lastOpenedAt TimestamptzString  @default(now())
  finishedAt   TimestamptzString?
  readTimeMs   Int       @default(0)
  moduleId     Int
  studentId    Int
  module       Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([moduleId, studentId])
  @@index([studentId, lastOpenedAt])

  @@map("ModuleRead")
}

/// Suivi de lecture d'un cours par un apprenant.
model CourseRead {
  id           Int       @id @default(autoincrement())
  beganAt      TimestamptzString  @default(now())
  lastOpenedAt TimestamptzString  @default(now())
  finishedAt   TimestamptzString?
  readTimeMs   Int       @default(0)
  courseId     Int
  studentId    Int
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, lastOpenedAt])

  @@map("CourseRead")
}

/// Suivi de lecture d'une activité par un apprenant.
model ActivityRead {
  id           Int       @id @default(autoincrement())
  beganAt      TimestamptzString  @default(now())
  lastOpenedAt TimestamptzString  @default(now())
  finishedAt   TimestamptzString?
  readTimeMs   Int       @default(0)
  activityId   Int
  studentId    Int
  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId])
  @@index([studentId, lastOpenedAt])

  @@map("ActivityRead")
}

/// Une passation de quiz par un apprenant.
/// `origin` distingue notamment le quiz formatif "je veux me tester" (self_test).
model QuizAttempt {
  id             Int          @id @default(autoincrement())
  quizId         Int
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  origin         String
  startedAt      TimestamptzString     @default(now())
  finishedAt     TimestamptzString?
  totalQuestions Int          @default(0)
  correctAnswers Int          @default(0)
  answers        QuizAnswer[]

  @@index([studentId, startedAt])

  @@map("QuizAttempt")
}

/// Réponse d'un apprenant à une question de quiz.
/// `isCorrect` est toujours calculé côté serveur, jamais fourni par le client.
model QuizAnswer {
  id             Int          @id @default(autoincrement())
  attemptId      Int
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizQuestionId Int
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  isCorrect      Boolean
  userAnswer     Json
  answeredAt     TimestamptzString     @default(now())

  @@unique([attemptId, quizQuestionId])
  @@index([attemptId])

  @@map("QuizAnswer")
}
