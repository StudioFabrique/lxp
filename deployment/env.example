# Variables d'un déploiement LXP.
#
# Ce fichier ne contient aucune valeur réelle. Il liste les clés attendues et
# leur origine. Ajoutez toute nouvelle variable dans ce fichier et dans les
# environnements Infisical concernés.
#
# Origines possibles :
#
#   [pipeline]  calculée par le job : tag de l'image, chemin cible et domaine.
#               Ne la placez pas dans Infisical. Le pipeline la calcule à
#               chaque exécution.
#   [/runtime]  configuration de la cible. En développement, ce dossier
#               contient aussi DEPLOY_SSH_* car il n'y a pas de préfixe.
#   [/mailer]   accès SMTP communs aux déploiements d'un environnement.
#   [/backup]   secrets de sauvegarde propres à la cible de développement.
#   [/ci]       en dev, accès au registre.
#   [<préfixe>/ci] en prod, accès au registre et SSH propres à la cible.
#   [<préfixe>/backup] en prod, secrets de sauvegarde propres à la cible.
#
# Dossiers lus par environnement :
#
#   dev   charge /ci, /runtime et /mailer ; les opérations de sauvegarde ajoutent
#         /backup. INFISICAL_PATH_PREFIX est ignoré.
#   prod  charge <INFISICAL_PATH_PREFIX>/ci,
#         <INFISICAL_PATH_PREFIX>/runtime et /mailer ; les opérations de
#         sauvegarde ajoutent <INFISICAL_PATH_PREFIX>/backup. Le préfixe
#         `/<instance>` est obligatoire, y compris pour le build.
#
# Voir la norme d'entreprise :
# https://docs.dev.step.eco/1-publication-application/1-gerer-les-secrets/


# ---------------------------------------------------------------------------
# [pipeline] Métadonnées du déploiement
# ---------------------------------------------------------------------------

# `caddy` raccorde l'application au proxy partagé ; `direct` publie le port 80.
DEPLOY_MODE=caddy

# Répertoire des données sur le serveur cible. Il contient seulement `data/`,
# `uploads/` et `logs/`. Il ne contient aucun `.env`, Compose ou script SQL.
DEPLOY_PATH=/home/<user>/lxp-dev

# Nomme la stack, les conteneurs, les réseaux et les volumes. Le changer sur
# une instance existante la ferait repartir de volumes vides.
LXP_DEPLOYMENT_NAME=lxp-dev

# Préférer un tag immuable à `latest`, seul moyen de revenir en arrière.
LXP_IMAGE=studiostep/lxp
LXP_IMAGE_TAG=dev-0000000000000000000000000000000000000000
LXP_AI_IMAGE=studiostep/lxp-ai
LXP_AI_IMAGE_TAG=latest

# Optionnel dans Jenkins. Lorsqu'elle est renseignée, une invitation root est
# envoyée après chaque déploiement. Ne pas placer cette valeur dans Infisical.
ROOT_ACCOUNT_EMAIL=

# Domaine sans protocole ni chemin. Exigé en mode `caddy`, où il alimente les
# labels du proxy partagé.
APP_HOST=lxp.dev.step.eco

# Facultatives.
COMPOSE_WAIT_TIMEOUT=240
DEPLOY_PRUNE=false
CADDY_NETWORK=caddy


# ---------------------------------------------------------------------------
# [dev /ci ou prod <préfixe>/ci] Accès au registre
# ---------------------------------------------------------------------------

REGISTRY_USER=
REGISTRY_TOKEN=
# Facultatif. Laisser vide pour Docker Hub ; sinon utiliser le nom du registre,
# par exemple ghcr.io ou registry.example.com:5000 (sans protocole).
REGISTRY_URL=

# Avec un registre alternatif, préfixez aussi LXP_IMAGE et LXP_AI_IMAGE par le
# nom du registre. REGISTRY_URL sert uniquement à l'authentification Docker.


# ---------------------------------------------------------------------------
# [dev /runtime ou prod <préfixe>/ci] Accès SSH propre à la cible
# ---------------------------------------------------------------------------

DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22
# Contenu complet de la clé privée, en-têtes compris.
DEPLOY_SSH_PRIVATE_KEY=

# DEPLOY_SSH_KEY_FILE existe aussi, pour un agent qui dépose lui-même la clé sur
# le disque. Ne le placez JAMAIS dans Infisical : son chemin est propre à une
# exécution, et une valeur figée dans le coffre fait échouer tous les
# déploiements suivants sur un « Permission denied (publickey) » trompeur.


# ---------------------------------------------------------------------------
# [dev /backup ou prod <préfixe>/backup] Sauvegarde propre à la cible
# ---------------------------------------------------------------------------

# Chaque destination est indépendante. Les pipelines ignorent la sauvegarde
# tant que les trois valeurs restent à false.
BACKUP_LOCAL_ENABLED=false
BACKUP_EXTERNAL_VOLUME_ENABLED=false
BACKUP_S3_ENABLED=false

# Dépôt sur le disque du VPS, hors de DEPLOY_PATH. Cette copie protège des
# suppressions accidentelles, mais pas de la perte du disque ou du VPS.
BACKUP_LOCAL_REPOSITORY=/home/<user>/lxp-backups/lxp-dev

# Dépôt sur un disque ou volume distinct de DEPLOY_PATH. Quand cette
# destination est active, le script compare les systèmes de fichiers.
BACKUP_EXTERNAL_VOLUME_REPOSITORY=/mnt/lxp-backups/lxp-dev

# URL du dépôt Restic. Pour un fournisseur compatible S3, placez son endpoint
# dans cette URL.
BACKUP_S3_REPOSITORY=s3:https://s3.example.com/lxp-backups/lxp-dev
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=eu-west-3

# Restic chiffre tous les dépôts actifs avec ce mot de passe. Sa perte rend
# les sauvegardes illisibles ; conservez une copie dans un coffre distinct.
BACKUP_RESTIC_PASSWORD=

# Les scripts fixent les images d'outillage. Ces surcharges servent aux tests
# sur un registre miroir et ne vont pas dans Infisical.
# BACKUP_RESTIC_IMAGE=ghcr.io/restic/restic:0.19.1
# BACKUP_HELPER_IMAGE=busybox:1.37.0


# ---------------------------------------------------------------------------
# [/runtime] Application
# ---------------------------------------------------------------------------

PORT=3000
ENVIRONMENT=production
FRONT_URL=https://lxp.dev.step.eco/
REGISTER_SECRET=
# Durée de validité des clés root générées sur le serveur, en minutes.
ROOT_ACTIVATION_TOKEN_TTL_MINUTES=30
SECRET=


# ---------------------------------------------------------------------------
# [/runtime] PostgreSQL applicatif
# ---------------------------------------------------------------------------

POSTGRES_USER=lxp
POSTGRES_PASSWORD=
# Facultatif, valeur par défaut : lxp.
# POSTGRES_DB=lxp


# ---------------------------------------------------------------------------
# [/runtime] MongoDB
# ---------------------------------------------------------------------------

MONGO_ADMIN_USERNAME=lxp
MONGO_ADMIN_PASSWORD=
# Facultatif, valeur par défaut : lxp.
# MONGO_DATABASE=lxp


# ---------------------------------------------------------------------------
# [/mailer] Courriel
# ---------------------------------------------------------------------------

MAILER_EMAIL=contact@example.com
MAILER_PASSWORD=
MAILER_SMTP=smtp.example.com
# Facultatif en production ; sert uniquement à rediriger les mails en développement.
MAILER_DEV_RECIPIENT=
MAILER_SMTP_PORT=587
MAILER_FROM="ANDRIA <contact@example.com>"


# ---------------------------------------------------------------------------
# [/runtime] Images Unsplash
# ---------------------------------------------------------------------------

UNSPLASH_ACCESS_KEY=


# ---------------------------------------------------------------------------
# [/runtime] Couche IA : inutile sur l'instance de démonstration
# ---------------------------------------------------------------------------

ANDRIA_POSTGRES_USER=andria
ANDRIA_POSTGRES_PASSWORD=
# Facultatif, valeur par défaut : lxp_ai.
# ANDRIA_POSTGRES_DB=lxp_ai

# Facultatif : compte en lecture seule utilisé par le service IA pour lire la
# base métier. À défaut, POSTGRES_USER et POSTGRES_PASSWORD sont réutilisés.
# LXP_DB_USER=
# LXP_DB_PASSWORD=

# DATABASE_URL, MONGO_LOCAL_URL, ANDRIA_AI_DB_URL et LXP_DB_URL sont calculées
# par deployment/deploy.sh et ne doivent pas être enregistrées dans Infisical.

DOCKER_IA_API_BASE_URL=http://ai:8000
# DOCKER_IA_AUTH_SECRET et SECRET_KEY doivent porter la même valeur : c'est le
# secret partagé entre le LXP et ANDRIA-IA.
DOCKER_IA_AUTH_SECRET=
SECRET_KEY=

MISTRAL_STUDENT_API_KEY=
MISTRAL_CONTENT_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LXP_PUBLIC_BASE=https://lxp.dev.step.eco

# Réglages du générateur de quiz. Les valeurs par défaut du Compose suffisent.
QUIZ_TEMPERATURE=0.5
QUIZ_MAX_TOKENS=1200
QUIZ_MAX_ATTEMPTS=3
QUIZ_PARALLEL_SLOTS=3
QUIZ_MIN_PROMPT_LEN=12
QUIZ_MIN_EXPLANATION_LEN=10
DB_INGEST_MIN_WORDS=20

# Coupe les routes IA sans activer les autres protections du mode démo.
DISABLE_AI_FEATURES=false


# ---------------------------------------------------------------------------
# [/runtime] Mode démonstration
# ---------------------------------------------------------------------------

# Sur `true`, l'API refuse toute écriture, expose l'ouverture d'une session
# publique, et le déploiement ignore la couche IA. Réservé à l'instance dédiée :
# ne jamais l'activer sur une instance portant des données réelles.
DEMO_MODE=false

# Adresse de l'instance de démonstration, renseignée sur les AUTRES instances.
DEMO_URL=
DEMO_EXIT_URL=

# À défaut, SECRET est utilisée pour signer les défis anti-robot.
ALTCHA_HMAC_KEY=

# Comptes empruntés par les visiteurs. Exigés lorsque DEMO_MODE vaut `true`.
DEMO_ADMIN_EMAIL=
DEMO_STUDENT_EMAIL=


# ---------------------------------------------------------------------------
# Un mot sur le front
# ---------------------------------------------------------------------------
#
# Les variables `VITE_*` ne figurent pas ici. Vite les compile dans le bundle
# servi à tous les visiteurs : elles sont publiques et sont présentes dans
# `front/.env.production`, versionné. Un secret ne doit jamais porter ce
# préfixe.
