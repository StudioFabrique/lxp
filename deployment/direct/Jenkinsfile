pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'INFISICAL_CREDENTIAL_ID', defaultValue: 'INFISICAL_LXP', trim: true, description: 'Credential Jenkins portant le Client ID et le Client Secret de la Machine Identity de cette instance')
        string(name: 'INFISICAL_PROJECT_ID', defaultValue: '', trim: true, description: 'Project ID du projet LXP dans Infisical')
        string(name: 'INFISICAL_ENVIRONMENT', defaultValue: 'prod', trim: true, description: 'Slug Infisical : dev, staging ou prod')
        string(name: 'INFISICAL_PATH_PREFIX', defaultValue: '', trim: true, description: 'Vide pour la cible principale ; /demo pour la démonstration dans dev')
        string(name: 'DEPLOY_PATH', defaultValue: '/home/martin/lxp', trim: true, description: 'Répertoire persistant sur le serveur cible')
        string(name: 'LXP_DEPLOYMENT_NAME', defaultValue: 'lxp', trim: true, description: 'Nom stable de la stack et de ses volumes')
        string(name: 'LXP_IMAGE_TAG', defaultValue: 'latest', trim: true, description: 'Tag LXP, latest ou SHA Jenkins pour un retour arrière')
        string(name: 'LXP_AI_IMAGE_TAG', defaultValue: 'latest', trim: true, description: 'Tag de l’image ANDRIA-IA')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy and migrate') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.INFISICAL_CREDENTIAL_ID,
                        usernameVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_ID',
                        passwordVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET'
                    )
                ]) {
                    sh '''
                        set -eu

                        export PIPELINE_DEPLOY_MODE=direct
                        export PIPELINE_DEPLOY_PATH="$DEPLOY_PATH"
                        export PIPELINE_LXP_DEPLOYMENT_NAME="$LXP_DEPLOYMENT_NAME"

                        export PIPELINE_LXP_IMAGE=studiostep/lxp
                        export PIPELINE_LXP_IMAGE_TAG="$LXP_IMAGE_TAG"
                        export PIPELINE_LXP_AI_IMAGE=studiostep/lxp-ai
                        export PIPELINE_LXP_AI_IMAGE_TAG="$LXP_AI_IMAGE_TAG"

                        export PIPELINE_COMPOSE_WAIT_TIMEOUT=240
                        export PIPELINE_DEPLOY_PRUNE=true

                        ./deployment/with-infisical.sh ./deployment/deploy.sh
                    '''
                }
            }
        }
    }
}
