pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'INFISICAL_CREDENTIAL_ID', defaultValue: 'INFISICAL_CREDENTIALS', trim: true, description: 'Laisser tel quel : le credential du dossier Jenkins est résolu en premier. À changer seulement pour un job hors dossier ou deux instances dans le même dossier.')
        choice(name: 'INFISICAL_DOMAIN', choices: ['https://eu.infisical.com', 'https://app.infisical.com'], description: 'Région Infisical. L\'organisation est sur EU ; l\'instance US ne connaît pas ses identités et répond 401.')
        string(name: 'INFISICAL_PROJECT_ID', defaultValue: '7f01d005-b9ab-4c92-bbad-3d6e8798c347', trim: true, description: 'Project ID du projet LXP. Identifiant public, inutilisable sans les credentials.')
        choice(name: 'INFISICAL_ENVIRONMENT', choices: ['prod', 'pre-prod', 'dev'], description: 'Charge /ci et /runtime en dev ; en prod, /ci puis <préfixe>/ci et <préfixe>/runtime. Les sauvegardes ajoutent le dossier backup de la cible.')
        string(name: 'INFISICAL_PATH_PREFIX', defaultValue: '', trim: true, description: 'Ignoré en dev. Obligatoire en prod : /demo ou /instances/<slug> ; détermine aussi <préfixe>/backup.')
        string(name: 'DEPLOY_PATH', defaultValue: '', trim: true, description: 'Répertoire persistant sur le serveur cible. Laisser vide : déduit en <foyer du compte de déploiement>/<nom de la stack>.')
        string(name: 'LXP_DEPLOYMENT_NAME', defaultValue: 'lxp', trim: true, description: 'Nom stable de la stack et de ses volumes')
        string(name: 'APP_HOST', defaultValue: 'lxp.dev.step.eco', trim: true, description: 'Domaine sans protocole, injecté dans les labels du proxy Caddy')
        string(name: 'LXP_IMAGE_TAG', defaultValue: 'latest', trim: true, description: 'Tag LXP, latest ou SHA Jenkins pour un retour arrière')
        string(name: 'LXP_AI_IMAGE_TAG', defaultValue: 'latest', trim: true, description: 'Tag de l’image ANDRIA-IA')
    }

    // Les paramètres sont lus ici par `params`, jamais depuis l'environnement du
    // shell. Au tout premier build d'un job, Jenkins n'a pas encore enregistré
    // les paramètres déclarés dans ce fichier et ne les expose donc pas comme
    // variables : un `sh` qui lirait `$DEPLOY_PATH` échouerait sur `set -u`.
    // `params` applique les valeurs par défaut dès le premier passage.
    environment {
        INFISICAL_DOMAIN      = "${params.INFISICAL_DOMAIN}"
        INFISICAL_PROJECT_ID  = "${params.INFISICAL_PROJECT_ID}"
        INFISICAL_ENVIRONMENT = "${params.INFISICAL_ENVIRONMENT}"
        INFISICAL_PATH_PREFIX = "${params.INFISICAL_PATH_PREFIX}"

        PIPELINE_DEPLOY_MODE         = 'caddy'
        PIPELINE_DEPLOY_PATH         = "${params.DEPLOY_PATH}"
        PIPELINE_LXP_DEPLOYMENT_NAME = "${params.LXP_DEPLOYMENT_NAME}"
        PIPELINE_APP_HOST            = "${params.APP_HOST}"

        PIPELINE_LXP_IMAGE        = 'studiostep/lxp'
        PIPELINE_LXP_IMAGE_TAG    = "${params.LXP_IMAGE_TAG}"
        PIPELINE_LXP_AI_IMAGE     = 'studiostep/lxp-ai'
        PIPELINE_LXP_AI_IMAGE_TAG = "${params.LXP_AI_IMAGE_TAG}"

        PIPELINE_COMPOSE_WAIT_TIMEOUT = '240'
        PIPELINE_DEPLOY_PRUNE         = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backup before migration') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.INFISICAL_CREDENTIAL_ID,
                        usernameVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_ID',
                        passwordVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET'
                    )
                ]) {
                    sh 'INFISICAL_SECRET_PATHS="/ci /runtime /backup" BACKUP_REASON=pre-deploy BACKUP_ALLOW_UNINITIALIZED=true ./deployment/with-infisical.sh ./deployment/backup.sh'
                }
            }
        }

        stage('Deploy with Caddy and migrate') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.INFISICAL_CREDENTIAL_ID,
                        usernameVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_ID',
                        passwordVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET'
                    )
                ]) {
                    sh './deployment/with-infisical.sh ./deployment/deploy.sh'
                }
            }
        }

        stage('Backup deployed state') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.INFISICAL_CREDENTIAL_ID,
                        usernameVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_ID',
                        passwordVariable: 'INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET'
                    )
                ]) {
                    sh 'INFISICAL_SECRET_PATHS="/ci /runtime /backup" BACKUP_REASON=post-deploy ./deployment/with-infisical.sh ./deployment/backup.sh'
                }
            }
        }
    }
}
