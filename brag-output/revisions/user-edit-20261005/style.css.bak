*{box-sizing:border-box}html,body{margin:0;width:1920px;height:1080px;overflow:hidden}body{font-family:system-ui,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:var(--color-base-100);color:var(--color-base-content)}h1,h2,h3,h4,p{margin:0}h1,h2,h3,h4{letter-spacing:-.045em}h2{font-size:66px;line-height:1.12;font-weight:750}small{font-size:21px}b,strong{font-weight:700}.clip{position:absolute;inset:0;overflow:hidden}.accent{color:var(--color-primary)}.atmosphere{position:absolute;inset:0;overflow:hidden;pointer-events:none}.orb{position:absolute;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--color-primary) 23%,transparent),transparent 68%)}.orb-one{width:1300px;height:1300px;left:900px;top:-500px}.orb-two{width:1100px;height:1100px;left:-600px;top:430px}.floor-grid{position:absolute;left:0;right:0;bottom:-260px;height:580px;background-image:linear-gradient(color-mix(in srgb,var(--color-primary) 12%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--color-primary) 12%,transparent) 1px,transparent 1px);background-size:90px 90px;transform:perspective(800px) rotateX(55deg);transform-origin:50% 0}.topline,.bottomline{position:absolute;left:96px;right:96px;display:flex;align-items:center;justify-content:space-between;z-index:30;font-size:21px;letter-spacing:.08em}.topline{top:46px;color:var(--color-base-content)}.bottomline{bottom:36px;font-size:20px;letter-spacing:.02em;color:var(--color-base-content)}.wordmark{display:flex;align-items:center;gap:18px;font-weight:750;font-size:26px}.separator{display:block;width:1px;height:22px;background:var(--color-primary)}.progress-track{position:absolute;bottom:0;left:0;right:0;height:5px;background:var(--color-base-300);z-index:40}#film-progress{height:100%;background:var(--color-primary);transform-origin:left center}.eyebrow{font-size:23px;font-weight:650;letter-spacing:.18em;color:var(--color-primary);margin-bottom:20px}.scene-title{position:absolute;top:140px;left:96px}.intro-layout{position:absolute;inset:200px 96px 160px;display:grid;grid-template-columns:1.05fr 1fr;gap:70px;align-items:center}.intro-copy h1{font-size:116px;line-height:1.08;font-weight:780}.intro-copy h1 span{display:block}.intro-rule,.outro-rule{height:3px;width:140px;background:var(--color-primary);transform-origin:left center;margin-top:42px}.intro-note{margin-top:28px;font-size:30px}.logo-stage{perspective:1200px;display:flex;flex-direction:column;align-items:center;gap:46px}#intro-logo{width:760px;transform-style:preserve-3d}.brand-svg{display:block;width:100%;height:auto;overflow:visible}.logo-pixel.ink{fill:var(--color-base-content)}.logo-pixel.plate{fill:var(--color-primary)}.logo-pixel.inverse{fill:var(--color-primary-content)}.logo-caption{font-size:24px;letter-spacing:.4em;color:var(--color-primary)}.hierarchy-layout{position:absolute;top:290px;left:96px;right:96px;bottom:120px;display:grid;grid-template-columns:480px 1fr;gap:75px}.hierarchy-index{display:flex;flex-direction:column;gap:12px;padding-top:8px}.level-label{display:flex;gap:23px;align-items:center;height:91px;font-size:31px}.level-label b{font-size:22px;color:var(--color-primary);border:1px solid var(--color-primary);width:45px;height:45px;display:grid;place-items:center;border-radius:50%}.depth-stage{position:relative;perspective:1400px;perspective-origin:50% 45%;height:645px}.depth-world{position:absolute;inset:0;transform-style:preserve-3d;will-change:transform}.level-card{position:absolute;left:0;width:990px;height:94px;border:2px solid var(--color-base-300);border-radius:16px;background:var(--color-base-200);color:var(--color-base-content);display:flex;align-items:center;gap:22px;padding:14px 25px;box-shadow:0 14px 34px color-mix(in srgb,var(--color-base-100) 65%,transparent);transform-style:preserve-3d}.level-card:nth-child(1){top:0}.level-card:nth-child(2){top:106px;left:14px;width:962px}.level-card:nth-child(3){top:212px;left:28px;width:934px}.level-card:nth-child(4){top:318px;left:42px;width:906px}.level-card:nth-child(5){top:424px;left:56px;width:878px}.level-card:nth-child(6){top:530px;left:70px;width:850px;border-color:var(--color-primary)}.level-number{font-size:36px;color:var(--color-primary);width:57px}.level-card small{font-size:17px;letter-spacing:.1em;color:var(--color-primary);display:block;margin-bottom:2px}.level-card h3{font-size:28px;font-weight:700}.level-card p{font-size:19px;margin-top:2px}.card-corner{margin-left:auto;font-size:33px;color:var(--color-primary)}.activity-layout{position:absolute;top:300px;left:96px;right:96px;bottom:100px;display:grid;grid-template-columns:335px 1fr;gap:55px}.activity-palette{padding:25px 22px;background:var(--color-base-200);border:2px solid var(--color-base-300);border-radius:22px;height:650px}.palette-title{font-size:25px;font-weight:700;margin-bottom:22px}.activity-type{display:flex;align-items:center;gap:17px;padding:16px 14px;min-height:82px;border:2px solid transparent;border-radius:12px;margin-bottom:8px;font-size:23px}.activity-type.selected{border-color:var(--color-primary);background:color-mix(in srgb,var(--color-primary) 12%,var(--color-base-200))}.activity-type small{display:block;font-size:18px;margin-top:3px}.type-icon{font-weight:700;font-size:31px;width:37px;flex:none;color:var(--color-primary)}.editor-stage{perspective:1500px;position:relative}.window{border:2px solid var(--color-base-300);border-radius:23px;background:var(--color-base-100);color:var(--color-base-content);box-shadow:0 28px 70px color-mix(in srgb,var(--color-neutral) 28%,transparent)}#editor-window{height:645px;overflow:hidden;transform-style:preserve-3d}.window-header{height:58px;background:var(--color-base-200);display:flex;align-items:center;gap:24px;padding:0 24px;font-size:20px;border-bottom:2px solid var(--color-base-300)}.window-dots{display:flex;gap:8px}.window-dots i{width:10px;height:10px;border-radius:50%;background:var(--color-primary)}.badge{margin-left:auto;font-