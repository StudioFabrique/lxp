  <audio id="sfx-editor" src="assets/impact.ogg" data-start="8.74" data-duration="0.19" data-track-index="13" data-volume="0.5"></audio>
  <audio id="sfx-theme1" src="assets/click.ogg" data-start="15.29" data-duration="0.01" data-track-index="14" data-volume="0.5"></audio>
  <audio id="sfx-theme2" src="assets/click.ogg" data-start="16.38" data-duration="0.01" data-track-index="15" data-volume="0.5"></audio>
