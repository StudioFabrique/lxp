[data-theme="aurora"]{--color-primary:#a78bfa;--color-primary-content:#1e103e;--color-secondary:#22d3ee;--color-secondary-content:#083344;--color-accent:#f472b6;--color-accent-content:#500724;--color-neutral:#312e5a;--color-neutral-content:#f5f3ff;--color-base-100:#1e1d27;--color-base-200:#1a1830;--color-base-300:#2a2750;--color-base-content:#f5f3ff;--color-info:#38bdf8;--color-info-content:#082f49;--color-success:#4ade80;--color-success-content:#022c22;--color-warning:#facc15;--color-warning-content:#451a03;--color-error:#fb7185;--color-error-content:#4c0519;--radius-selector:0.5rem;--radius-field:0.5rem;--radius-box:1rem;--border:1px;--depth:1;--noise:0;--sidebar-bg:#221e46;--sidebar-content:#f5f3ff;--sidebar-surface:#312e5a;--sidebar-hover:#403a73;--sidebar-active:#312e5a;--sidebar-active-content:#f5f3ff;--sidebar-border:#4c4680;}
*{box-sizing:border-box}html,body{margin:0;width:1920px;height:1080px;overflow:hidden}body{font-family:system-ui,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:var(--color-base-100);color:var(--color-base-content)}h1,h2,h3,h4,p{margin:0}h1,h2,h3,h4{letter-spacing:-.045em}h2{font-size:66px;line-height:1.12;font-weight:750}small{font-size:21px}b,strong{font-weight:700}.clip{position:absolute;inset:0;overflow:hidden}.accent{color:var(--color-primary)}.atmosphere{position:absolute;inset:0;overflow:hidden;pointer-events:none}.orb{position:absolute;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--color-primary) 23%,transparent),transparent 68%)}.orb-one{width:1300px;height:1300px;left:900px;top:-500px}.orb-two{width:1100px;height:1100px;left:-600px;top:430px}.floor-grid{position:absolute;left:0;right:0;bottom:-260px;height:580px;background-image:linear-gradient(color-mix(in srgb,var(--color-primary) 12%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--color-primary) 12%,transparent) 1px,transparent 1px);background-size:90px 90px;transform:perspective(800px) rotateX(55deg);transform-origin:50% 0}.topline,.bottomline{position:absolute;left:96px;right:96px;display:flex;align-items:center;justify-content:space-between;z-index:30;font-size:21px;letter-spacing:.08em}.topline{top:46px;color:var(--color-base-content)}.bottomline{bottom:36px;font-size:20px;letter-spacing:.02em;color:var(--color-base-content)}.wordmark{display:flex;align-items:center;gap:18px;font-weight:750;font-size:26px}.separator{display:block;width:1px;height:22px;background:var(--color-primary)}.progress-track{position:absolute;bottom:0;left:0;right:0;height:5px;background:var(--color-base-300);z-index:40}#film-progress{height:100%;background:var(--color-primary);transform-origin:left center}.eyebrow{font-size:23px;font-weight:650;letter-spacing:.18em;color:var(--color-primary);margin-bottom:20px}.scene-title{posit