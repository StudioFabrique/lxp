play:grid;grid-template-columns:325px 1fr;gap:70px}.theme-list{display:flex;flex-direction:column;justify-content:center;gap:27px}.theme-option{border:2px solid var(--color-base-300);border-radius:20px;padding:24px 25px;color:var(--color-base-content);background:var(--color-base-100);display:grid;grid-template-columns:1fr auto;gap:17px}.swatches{grid-column:1/-1;display:flex;gap:10px}.swatches i{height:32px;width:67px;border-radius:8px;background:var(--color-primary)}.swatches i:nth-child(2){background:var(--color-secondary)}.swatches i:nth-child(3){background:var(--color-neutral)}.theme-option b{font-size:30px}.theme-option span{font-size:23px;align-self:center}.dashboard-stage{perspective:1600px;display:grid;align-items:center}.dashboard{height:560px;display:flex;overflow:hidden;transform-style:preserve-3d}.sidebar{width:235px;flex:none;background:var(--color-neutral);color:var(--color-neutral-content);padding:35px 20px;display:flex;flex-direction:column;gap:18px;font-size:22px}.sidebar-brand{font-weight:800;letter-spacing:.1em;font-size:27px;margin-bottom:35px}.sidebar span:not(.sidebar-brand){padding:10px 12px}.nav-active{border:1px solid currentColor;border-radius:10px}.sidebar-bottom{margin-top:auto}.dashboard-main{padding:36px;flex:1;min-width:0}.dashboard-greeting{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}.dashboard-greeting h3{font-size:36px}.avatar{height:57px;width:57px;border-radius:50%;display:grid;place-items:center;background:var(--color-primary);color:var(--color-primary-content);font-size:26px;font-weight:700;flex:none}.dashboard-cards{display:grid;grid-template-columns:1.1fr 1fr;gap:20px}.card{border:2px solid var(--color-base-300);border-radius:17px;background:var(--color-base-200);padding:22px;color:var(--color-base-content)}.card small{color:var(--color-primary);font-size:17px;letter-spacing:.07em;font-weight:700}.card h4{font-size:27px;margin:13px 0 8px}.card p{font-size:21px}.meter{height:8px;border-radius:10px;background:var(--color-base-300);overflow:hidden;margin:22px 0 11px}.meter i{display:block;height:100%;width:68%;background:var(--color-primary);border-radius:10px}.card>span{font-size:18px}.mood-mini svg{width:64px;height:64px;display:block;margin:10px 0;fill:none;stroke:var(--color-primary);stroke-width:1.5}.mood-mini p{font-size:20px}.next-lesson{display:flex;align-items:center;gap:20px;margin-top:23px}.next-lesson h4{margin:8px 0 4px;font-size:26px}.play-icon{font-size:38px!important;color:var(--color-primary)}.button{background:var(--color-primary);color:var(--color-primary-content);border-radius:10px;padding:15px 23px;font-size:23px;font-weight:650;display:inline-block}.next-lesson .button{margin-left:auto;white-space:nowrap;font-size:19px}.care-layout{position:absolute;top:310px;left:96px;right:96px;bottom:120px;display:grid;grid-template-columns:1fr 1fr;gap:43px;perspective:1500px}.alert-panel{padding:30px;height:605px;background:var(--color-base-200)}.care-panel-title{display:flex;align-items:center;gap:16px;padding-bottom:25px;border-bottom:2px solid var(--color-base-300)}.care-panel-title h3{font-size:32px}.care-panel-title .doc-kicker{font-size:16px}.alert-symbol{height:50px;width:50px;border:2px solid var(--color-error);color:var(--color-error);border-radius:14px;display:grid;place-items:center;font-size:35px;font-weight:750}.critical-badge{background:var(--color-error);color:var(--color-error-content);padding:9px 13px;border-radius:9px;font-size:20px;font-weight:700;margin-left:auto;white-space:nowrap}.student-row{display:flex;gap:17px;align-items:center;margin:28px 0 32px}.student-row h4{font-size:30px}.student-row p{font-size:21px;margin-top:3px}.indicators{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px}.indicators small{display:block;font-size:22px;margin-bottom:15px}.indicators strong{font-size:32px;letter-spacing:-.04em}.indicators .meter{margin-top:20px}.warning-meter i{background:var(--color-error)}.alert-review{height:67px;margin-top:26px;position:relative}.review-success{position:absolute;inset:0;display:flex;align-items:center;color:var(--color-success);font-size:26px;font-weight:700}.contact-card{display:flex;align-items:center;gap:18px;border-top:2px solid var(--color-base-300);padding-top:23px;margin-top:27px}.small-avatar{width:43px;height:43px;font-size:22px}.contact-card small{display:block;font-size:16px;color:var(--color-primary);letter-spacing:.07em;margin-bottom:5px}.contact-card b{font-size:23px}.contact-action{margin-left:auto;color:var(--color-primary);font-size:22px}.feedback-area{display:flex;flex-direction:column;gap:22px}.feedback-panel{padding:26px 30px;height:330px;background:var(--color-base-200)}.feedback-heading{display:flex;align-items:center;gap:22px}.feedback-heading h3{font-size:29px;line-height:1.2;max-width:510px}.feedback-heading .doc-kicker{font-size:19px}#mood-svg{width:115px;height:115px;flex:none;fill:none;stroke:var(--color-primary);stroke-width:5;stroke-linecap:round;stroke-linejoin:round}#mood-detail{fill:var(--color-primary);stroke-width:1}#mood-rays{opacity:0}.mood-track{height:7px;border-radius:8px;background:var(--color-base-300);position:relative;margin:12px 0 26px}#mood-progress{display:block;background:var(--color-primary);width:100%;height:100%;transform-origin:left center}#mood-knob{position:absolute;left:0;top:-8px;height:23px;width:23px;background:var(--color-primary);border-radius:50%}.student-feedback{font-size:29px;letter-spacing:-.03em}.feedback-footer{display:flex;justify-content:space-between;font-size:19px;padding-top:19px;color:var(--color-primary)}.teacher-note{background:var(--color-base-200);border:2px solid var(--color-primary);border-radius:18px;padding:25px 30px;height:252px}.teacher-note h4{font-size:29px;margin-bottom:10px}.teacher-note>p:not(.doc-kicker){font-size:19px;margin-bottom:11px}.teacher-note .doc-kicker{font-size:17px}.note-content{font-size:23px;line-height:1.35}.note-confirmation{display:block;margin-top:15px;font-size:19px;color:var(--color-success)}.outro-content{position:absolute;inset:170px 96px 130px;display:flex;flex-direction:column;align-items:center;justify-content:center}#outro-logo{width:740px;margin-bottom:55px;perspective:1000px}.outro-content h2{font-size:78px}.outro-content>p{font-size:25px;letter-spacing:.4em;margin-top:33px;color:var(--color-primary)}.outro-rule{width:210px;margin-top:32px}
</style>
