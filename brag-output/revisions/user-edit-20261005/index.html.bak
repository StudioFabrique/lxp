  <style>[data-theme="ocean"]{--color-primary:#0369a1;--color-primary-content:#ffffff;--color-secondary:#0891b2;--color-secondary-content:#dfeef5;--color-accent:#059669;--color-accent-content:#ffffff;--color-neutral:#164e63;--color-neutral-content:#f0f9ff;--color-base-100:#f0f9ff;--color-base-200:#e0f2fe;--color-base-300:#bae6fd;--color-base-content:#082f49;--color-info:#3b82f6;--color-info-content:#ffffff;--color-success:#10b981;--color-success-content:#ffffff;--color-warning:#f59e0b;--color-warning-content:#ffffff;--color-error:#ef4444;--color-error-content:#ffffff;--radius-selector:0.5rem;--radius-field:0.5rem;--radius-box:1rem;--border:1px;--depth:1;--noise:0;--sidebar-bg:#0c4a6e;--sidebar-content:#f0f9ff;--sidebar-surface:#075985;--sidebar-hover:#036b8f;--sidebar-active:#075985;--sidebar-active-content:#f0f9ff;--sidebar-border:#0e7490;}
