class="logo-pixel inverse" id="outro-pixel-528" d="M209.9 47.7388H213.532V51.3127H209.9V47.7388Z" /><path data-hf-id="hf-ckye" class="logo-pixel inverse" id="outro-pixel-529" d="M206.27 47.7388H209.9V51.3127H206.27V47.7388Z" /><path data-hf-id="hf-cqb1" class="logo-pixel inverse" id="outro-pixel-530" d="M202.638 47.7388H206.27V51.3127H202.638V47.7388Z" /><path data-hf-id="hf-az9i" class="logo-pixel inverse" id="outro-pixel-531" d="M195.377 47.7388H199.008V51.3127H195.377V47.7388Z" /><path data-hf-id="hf-ks38" class="logo-pixel inverse" id="outro-pixel-532" d="M191.746 47.7388H195.377V51.3127H191.746V47.7388Z" /><path data-hf-id="hf-dsug" class="logo-pixel inverse" id="outro-pixel-533" d="M199.008 47.7388H202.638V51.3127H199.008V47.7388Z" /><path data-hf-id="hf-3wkh" class="logo-pixel inverse" id="outro-pixel-534" d="M199.008 51.3127H202.638V54.8866H199.008V51.3127Z" /><path data-hf-id="hf-97sn" class="logo-pixel inverse" id="outro-pixel-535" d="M199.008 54.8866H202.638V58.4605H199.008V54.8866Z" /><path data-hf-id="hf-4ng9" class="logo-pixel inverse" id="outro-pixel-536" d="M199.008 58.4605H202.638V62.0344H199.008V58.4605Z" /><path data-hf-id="hf-aouj" class="logo-pixel inverse" id="outro-pixel-537" d="M199.008 62.0344H202.638V66H199.008V62.0344Z" /><path data-hf-id="hf-9q8i" class="logo-pixel inverse" id="outro-pixel-538" d="M195.377 62.0344H199.008V66H195.377V62.0344Z" /><path data-hf-id="hf-toxc" class="logo-pixel inverse" id="outro-pixel-539" d="M191.746 62.0344H195.377V66H191.746V62.0344Z" /><path data-hf-id="hf-r12n" class="logo-pixel inverse" id="outro-pixel-540" d="M191.746 58.4605H195.377V62.0344H191.746V58.4605Z" /><path data-hf-id="hf-vlv7" class="logo-pixel inverse" id="outro-pixel-541" d="M191.746 54.8866H195.377V58.4605H191.746V54.8866Z" /><path data-hf-id="hf-8huv" class="logo-pixel inverse" id="outro-pixel-542" d="M191.746 51.3127H195.377V54.8866H191.746V51.3127Z" /><path data-hf-id="hf-mb87" class="logo-pixel inverse" id="outro-pixel-543" d="M195.377 51.3127H199.008V54.8866H195.377V51.3127Z" /><path data-hf-id="hf-gssr" class="logo-pixel inverse" id="outro-pixel-544" d="M195.377 54.8866H199.008V58.4605H195.377V54.8866Z" /><path data-hf-id="hf-ociv" class="logo-pixel inverse" id="outro-pixel-545" d="M195.377 58.4605H199.008V62.0344H195.377V58.4605Z" /><path data-hf-id="hf-xw05" class="logo-pixel inverse" id="outro-pixel-546" d="M217.162 51.3127H220.794V54.8866H217.162V51.3127Z" /><path data-hf-id="hf-gg4z" class="logo-pixel inverse" id="outro-pixel-547" d="M217.162 54.8866H220.794V58.4605H217.162V54.8866Z" /><path data-hf-id="hf-3ydl" class="logo-pixel inverse" id="outro-pixel-548" d="M217.162 58.4605H220.794V62.0344H217.162V58.4605Z" /><path data-hf-id="hf-jfy9" class="logo-pixel inverse" id="outro-pixel-549" d="M217.162 62.0344H220.794V66H217.162V62.0344Z" /><path data-hf-id="hf-l4gn" class="logo-pixel inverse" id="outro-pixel-550" d="M220.794 62.0344H224.424V66H220.794V62.0344Z" /><path data-hf-id="hf-e18a" class="logo-pixel inverse" id="outro-pixel-551" d="M224.424 62.0344H228.055V66H224.424V62.0344Z" /><path data-hf-id="hf-prwi" class="logo-pixel inverse" id="outro-pixel-552" d="M224.424 58.4605H228.055V62.0344H224.424V58.4605Z" /><path data-hf-id="hf-fgi6" class="logo-pixel inverse" id="outro-pixel-553" d="M224.424 54.8866H228.055V58.4605H224.424V54.8866Z" /><path data-hf-id="hf-yrme" class="logo-pixel inverse" id="outro-pixel-554" d="M224.424 51.3127H228.055V54.8866H224.424V51.3127Z" /><path data-hf-id="hf-tk0j" class="logo-pixel inverse" id="outro-pixel-555" d="M220.794 51.3127H224.424V54.8866H220.794V51.3127Z" /><path data-hf-id="hf-m1tf" class="logo-pixel inverse" id="outro-pixel-556" d="M220.794 54.8866H224.424V58.4605H220.794V54.8866Z" /><path data-hf-id="hf-sprr" class="logo-pixel inverse" id="outro-pixel-557" d="M220.794 58.4605H224.424V62.0344H220.794V58.4605Z" /><path data-hf-id="hf-ob8g" class="logo-pixel inverse" id="outro-pixel-558" d="M206.27 39H209.9V42.5738H206.27V39Z" /><path data-hf-id="hf-xlkx" class="logo-pixel inverse" id="outro-pixel-559" d="M209.9 39H213.532V42.5738H209.9V39Z" /><path data-hf-id="hf-6kcs" class="logo-pixel inverse" id="outro-pixel-560" d="M179.513 12L175.344 11.9995V15.5734H171.712V19.1473V22.7211H175.344L175.344 20.9998H178.974H179.513H182.606V22.7216H183.144H186.775V19.1477V15.5738H183.144V12H179.513Z" /><path data-hf-id="hf-x3o8" class="logo-pixel ink" id="outro-pixel-561" d="M137.069 27L132.55 27L132.55 33H137.069L137.069 27Z" /><path data-hf-id="hf-xhqe" class="logo-pixel ink" id="outro-pixel-562" d="M99.4125 30L93.388 30L93.3875 48H99.4119L99.4125 30Z" /></svg></div><h2 data-hf-id="hf-2l5r"><span data-hf-id="hf-fzoy">Former.</span> <span data-hf-id="hf-5g3i">Créer.</span> <span data-hf-id="hf-rwnh" class="accent">Accompagner.</span></h2><p style="text-align: center" data-hf-id="hf-jy00">Apprentissage Numérique &amp; Développement Renforcé par intelligence artificielle&#160;</p></div></section>

  
  
  
  
  
  
  
  
  
</div>
<script>/* One paused, deterministic timeline; Hyperframes owns seeking and playback. */
gsap.registerPlugin(MorphSVGPlugin);
const tl = gsap.timeline({ paused: true });
tl.set("#doc-code", { y: 20, x: 0, data: "hf-hold" }, 0);
tl.set(".intro-layout", { y: 174.726, x: 466.776, data: "hf-hold" }, 0);
tl.fromTo('#film-progress', { scaleX: 0 }, { scaleX: 1, duration: 25, ease: 'none' }, 0);
tl.fromTo('.orb-one', { x: 0, y: 0, scale: 1 }, { x: -120, y: 130, scale: 1.15, duration: 25, ease: 'sine.inOut' }, 0);
tl.fromTo('.orb-two', { x: 0, y: 0 }, { x: 160, y: -75, duration: 25, ease: 'sine.inOut' }, 0);

// Original SVG subpaths assemble deterministically, preserving the final mark.
document.querySelectorAll('#intro-logo .logo-pixel').forEach((pixel, index) => {
  const angle = index * 2.399963;
  tl.fromTo(pixel, { x: Math.cos(angle) * 45, y: Math.sin(angle) * 28, rotation: ((index % 7) - 3) * 8, opacity: 0 }, { x: 0, y: 0, rotation: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0.1 + (index % 30) * 0.014);
});
tl.fromTo('#intro-logo', { rotationY: -28, rotationX: 10, z: -130 }, { rotationY: 0, rotationX: 0, z: 0, duration: 1.25, ease: 'power3.out' }, 0.1);
tl.to('#intro-logo .ink', { fill: 'var(--color-primary)', duration: 0.55 }, 0.8);
tl.fromTo('.intro-copy .eyebrow', { opacity: 0, x: -35 }, { opacity: 1, x: 0, duration: 0.35 }, 0.08);
tl.fromTo('.intro-copy h1 span', { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.12, ease: 'power4.out' }, 0.15);
tl.fromTo('.intro-rule', { scaleX: 0 }, { scaleX: 1, duration: 0.5, ease: 'power2.out' }, 0.5);
tl.fromTo('.intro-note,.logo-caption', { opacity: 0 }, { opacity: 1, duration: 0.4 }, 0.75);
tl.to('.intro-layout', { keyframes: { "0%": { opacity: 1, y: 174.726, x: 466.776 }, "52.857%": { opacity: 1, y: 0, x: 0, ease: "none" }, "100%": { opacity: 0, y: -30, x: 0 }, easeEach: "power1.out" }, duration: 0.467 }, 1.933);

const sceneStarts = { hierarchy: 2.4, activities: 8.74, themes: 14.2, care: 17.47 };
Object.entries(sceneStarts).forEach(([scene, start]) => {
  tl.fromTo(`#${scene} .scene-title`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.4, ease: 'power3.out' }, start);
});

// Adapted camera-rig-depth-stack: stable lens, preserve-3d world, Z layers.
// beat-grid: levels at 2.73, 3.27, 3.82, 4.91, 6.00, 7.09; held together.
const levelTimes = [2.73, 3.27, 3.82, 4.91, 6, 7.09];
tl.fromTo('#pedagogical-world', { rotationY: -18, rotationX: 13, z: -100, x: 45 }, { rotationY: -7, rotationX: 4, z: -45, x: 10, duration: 4.5, ease: 'power2.inOut' }, 2.4);
levelTimes.forEach((start, index) => {
  tl.fromTo(`#level-${index}`, { opacity: 0, x: 120, z: 220 + index * 25, rotationY: -25 }, { opacity: 1, x: 0, z: index * 18, rotationY: 0, duration: 0.42, ease: 'power4.out' }, start);
  tl.fromTo(`#label-${index}`, { opacity: 0, x: -25 }, { opacity: 1, x: 0, duration: 0.32, ease: 'power3.out' }, start);
});
tl.to('#pedagogical-world', { rotationY: 0, rotationX: 0, z: 0, x: 0, duration: 0.55, ease: 'power3.out' }, 7.75);
tl.to('.level-card', { z: 0, duration: 0.45, ease: 'power3.out' }, 7.95);

// beat-locked: the editor reveal lands at the 8.74s strong cue.
tl.fromTo('.activity-palette', { opacity: 0, x: -90 }, { opacity: 1, x: 0, duration: 0.4, ease: 'power3.out' }, 8.74);
tl.fromTo('.activity-type', { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.35, stagger: 0.06 }, 8.94);
tl.fromTo('#editor-window', { opacity: 0, rotationY: 20, rotationX: 7, z: -240, x: 110 }, { opacity: 1, rotationY: 0, rotationX: 0, z: 0, x: 0, duration: 0.8, ease: 'power4.out' }, 8.74);
tl.fromTo('#doc-heading', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.3 }, 9.3);
tl.fromTo('#doc-paragraph', { opacity: 0 }, { opacity: 1, duration: 0.35 }, 9.55);
tl.fromTo('#doc-list p', { opacity: 0, x: -18 }, { opacity: 1, x: 0, duration: 0.3, stagger: 0.1 }, 9.83);
tl.fromTo('#doc-table', { opacity: 0, scaleY: 0.75, transformOrigin: 'top center' }, { opacity: 1, scaleY: 1, duration: 0.4, ease: 'power3.out' }, 10.37);
tl.to('#doc-code', { keyframes: { "0%": { opacity: 0, y: 20, x: 0 }, "59.406%": { opacity: 1, y: 0, x: 0 }, "100%": { opacity: 1, y: 25.078, x: 0, ease: "none" }, easeEach: "power1.out" }, duration: 0.673 }, 11.46);
tl.fromTo('.editor-capabilities span', { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.35, stagger: 0.09 }, 11.8);
['#table-tool', '#image-tool', '#code-tool'].forEach((selector, index) => {
  const start = [10.37, 10.93, 11.46][index];
  tl.to(selector, { backgroundColor: 'var(--color-primary)', color: 'var(--color-primary-content)', duration: 0.12 }, start);
  tl.to(selector, { backgroundColor: 'transparent', color: 'var(--color-base-content)', duration: 0.2 }, start + 0.5);
});

// The same DOM dashboard changes theme tokens, with reversible GSAP keyframes.
const themeTokens = {};
['ocean', 'sage', 'aurora'].forEach((name) => {
  const styles = getComputedStyle(document.getElementById('theme-' + name));
  themeTokens[name] = {};
  ['primary', 'primary-content', 'secondary', 'secondary-content', 'accent', 'neutral', 'neutral-content', 'base-100', 'base-200', 'base-300', 'base-content', 'success', 'error'].forEach((token) => {
    themeTokens[name][`--color-${token}`] = styles.getPropertyValue(`--color-${token}`).trim();
  });
});
tl.fromTo('#theme-dashboard', { rotationY: -18, rotationX: 7, z: -100, opacity: 0 }, { rotationY: 0, rotationX: 0, z: 0, opacity: 1, duration: 0.55, ease: 'power4.out' }, 14.2);
tl.fromTo('.theme-option', { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.35, stagger: 0.06 }, 14.2);
tl.fromTo('#theme-dashboard', themeTokens.ocean, { ...themeTokens.sage, duration: 0.32, ease: 'power2.inOut', immediateRender: false }, 15.29);
tl.to('#theme-dashboard', { ...themeTokens.aurora, duration: 0.32, ease: 'power2.inOut' }, 16.38);
[[14.2, 'ocean'], [15.29, 'sage'], [16.38, 'aurora']].forEach(([start, name]) => {
  tl.fromTo(`#theme-${name}`, { x: 0 }, { x: 22, duration: 0.2, ease: 'power3.out' }, start);
  if (name !== 'aurora') tl.to(`#theme-${name}`, { x: 0, duration: 0.2 }, start + 0.9);
});

// beat-locked: care reveal at 17.47s. The analysis is a prefilled example.
tl.fromTo('#alert-panel', { x: -110, rotationY: 12, opacity: 0 }, { x: 0, rotationY: 0, opacity: 1, duration: 0.55, ease: 'power3.out' }, 17.47);
tl.fromTo('#feedback-panel', { x: 90, rotationY: -12, opacity: 0 }, { x: 0, rotationY: 0, opacity: 1, duration: 0.55, ease: 'power3.out' }, 17.7);
tl.fromTo('.indicators .meter i', { scaleX: 0, transformOrigin: 'left center' }, { scaleX: 1, duration: 0.65, stagger: 0.12, ease: 'power3.out' }, 18.02);
tl.fromTo('#student-feedback', { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.35 }, 18.56);

// Continuous SVG silhouette morph, not a swap or a crossfade.
const cloud = 'M28 74 C8 74 8 45 26 42 C29 18 59 17 68 36 C87 30 107 45 105 63 C105 70 100 74 93 74 Z';
const sun = 'M91 60 C91 77 77 91 60 91 C43 91 29 77 29 60 C29 43 43 29 60 29 C77 29 91 43 91 60 Z';
const rain = 'M34 85 L27 103 M59 85 L52 103 M84 85 L77 103';
tl.fromTo('#mood-shape', { morphSVG: cloud }, { morphSVG: cloud, duration: 0.45 }, 17.47);
tl.to('#mood-detail', { morphSVG: rain, fill: 'none', strokeWidth: 5, duration: 0.55, ease: 'power2.inOut' }, 18.2);
tl.to('#mood-shape', { morphSVG: sun, duration: 1.0, ease: 'power2.inOut' }, 19.1);
tl.to('#mood-detail', { opacity: 0, duration: 0.55 }, 19.1);
tl.fromTo('#mood-rays', { opacity: 0, rotation: -25, svgOrigin: '60 60', scale: 0.7 }, { opacity: 1, rotation: 0, scale: 1, duration: 0.6, ease: 'power3.out' }, 19.55);
tl.fromTo('#mood-progress', { scaleX: 0.15 }, { scaleX: 0.95, duration: 2.0, ease: 'power2.inOut' }, 18.2);
tl.fromTo('#mood-knob', { x: 90 }, { x: 690, duration: 2.0, ease: 'power2.inOut' }, 18.2);
tl.fromTo('#teacher-note', { opacity: 0, y: 45, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: 'power3.out' }, 19.66);
tl.fromTo('#review-success', { opacity: 0 }, { opacity: 1, duration: 0.2 }, 20.39);
tl.to('#review-pending', { opacity: 0, duration: 0.2 }, 20.19);

// beat-locked: final identity lands at 22.93s and holds to the last frame.
tl.fromTo('#outro-logo', { opacity: 0, y: 30, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: 'power3.out' }, 22.93);
tl.set('#outro-logo .ink', { fill: 'var(--color-primary)' }, 22.93);
tl.fromTo('.outro-content h2 span', { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.35, stagger: 0.08, ease: 'power3.out' }, 23.04);
tl.fromTo('.outro-content>p', { opacity: 0 }, { opacity: 1, duration: 0.3 }, 23.35);
tl.fromTo('.outro-rule', { scaleX: 0 }, { scaleX: 1, duration: 0.45 }, 23.3);
window.__timelines = window.__timelines || {};
window.__timelines['main'] = tl;
</script>
</body>
</html>
