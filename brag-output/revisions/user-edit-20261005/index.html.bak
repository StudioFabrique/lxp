  <section data-hf-id="hf-4dnj" class="clip care" id="care" data-start="17.47" data-duration="5.46" data-track-index="5">
    <div data-hf-id="hf-dfnn" class="scene-title"><h2 data-hf-id="hf-p3b2">Accompagner les étudiants</h2></div>
    <div data-hf-id="hf-hzpi" class="care-layout">
      <article data-hf-id="hf-uyvt" class="alert-panel window" id="alert-panel"><div data-hf-id="hf-3m7e" class="student-row"><div data-hf-id="hf-9we0" class="avatar">C</div><div data-hf-id="hf-bc66"><h4 data-hf-id="hf-jure">Camille</h4><p data-hf-id="hf-dm17">Apprenante</p></div><span data-hf-id="hf-v4yc" class="critical-badge">Critique</span></div><div data-hf-id="hf-k5my" class="indicators"><div data-hf-id="hf-axv5"><small data-hf-id="hf-9k7a">Réussite</small><strong data-hf-id="hf-526v">42 %</strong><div data-hf-id="hf-wup7" class="meter"><i data-hf-id="hf-0jgm" style="width:42%"></i></div></div><div data-hf-id="hf-ajk4"><small data-hf-id="hf-wqso">Connexions</small><strong data-hf-id="hf-tbum">4 j / 30 j</strong><div data-hf-id="hf-wge6" class="meter"><i data-hf-id="hf-o5sg" style="width:13%"></i></div></div><div data-hf-id="hf-a593"><small data-hf-id="hf-9c0i">Inactivité</small><strong data-hf-id="hf-pdhb">8 jours</strong><div data-hf-id="hf-yk3v" class="meter warning-meter"><i data-hf-id="hf-njkh" style="width:65%"></i></div></div></div><div data-hf-id="hf-kew7" class="alert-review"><span data-hf-id="hf-knge" class="button" id="review-pending">Prendre en compte l’alerte</span><span data-hf-id="hf-85zx" class="review-success" id="review-success">✓ Alerte prise en compte</span></div><div data-hf-id="hf-33rb" class="contact-card"><span data-hf-id="hf-mcau" class="avatar small-avatar">E</span><div data-hf-id="hf-9qy2"><small data-hf-id="hf-u6rv">CONTACT PÉDAGOGIQUE</small><b data-hf-id="hf-5ov9">Équipe pédagogique</b></div><span data-hf-id="hf-a6m8" class="contact-action">Contacter ↗</span></div></article>
      <div data-hf-id="hf-t0vd" class="feedback-area"><article data-hf-id="hf-gvjd" class="feedback-panel window" id="feedback-panel"><div data-hf-id="hf-wl7c" class="feedback-heading"><div data-hf-id="hf-9cn1"><p data-hf-id="hf-7upo" class="doc-kicker">HUMEUR DU JOUR</p><h3 data-hf-id="hf-nn5z">Comment vous sentez-vous aujourd’hui ?</h3></div><svg data-hf-id="hf-oht0" id="mood-svg" viewBox="0 0 120 120" role="img" aria-label="Humeur météo, de l’orage au soleil"><path data-hf-id="hf-raz6" id="mood-shape" d="M28 74 C8 74 8 45 26 42 C29 18 59 17 68 36 C87 30 107 45 105 63 C105 70 100 74 93 74 Z" /><path data-hf-id="hf-4bzu" id="mood-detail" d="M63 61 L47 85 L61 85 L53 106 L79 78 L65 78 Z" /><path data-hf-id="hf-zakn" id="mood-rays" d="M60 5V15 M60 105V115 M5 60H15 M105 60H115 M21 21L28 28 M92 92L99 99 M21 99L28 92 M92 28L99 21" /></svg></div><div data-hf-id="hf-rlwb" class="mood-track"><i data-hf-id="hf-ucxw" id="mood-progress"></i><span data-hf-id="hf-4qzw" id="mood-knob"></span></div><p data-hf-id="hf-28tv" class="student-feedback" id="student-feedback">« Je bloque sur la dernière leçon. »</p><div data-hf-id="hf-lwxf" class="feedback-footer"><span data-hf-id="hf-x46q">Camille</span><span data-hf-id="hf-cwj3">Feedback apprenant</span></div></article><article data-hf-id="hf-it23" class="teacher-note" id="teacher-note"><p data-hf-id="hf-5ssf" class="doc-kicker">ÉQUIPE PÉDAGOGIQUE</p><h4 data-hf-id="hf-yz11">Feedback pris en compte</h4><p data-hf-id="hf-xttx">Note interne de review</p><div data-hf-id="hf-n6b2" class="note-content">Proposer un point sur la leçon et adapter l’accompagnement.</div><span data-hf-id="hf-zed7" class="note-confirmation">✓ Vu par l’équipe pédagogique</span></article></div>
    </div>
  </section>

