stage("Deploying to DEMO") {
    steps {
        withCredentials([
            file(credentialsId: 'INFA_ENV', variable: 'ENV_FILE'),
            string(credentialsId: 'INFA_HOST', variable: 'HOST'),
            string(credentialsId: 'INFA_USER', variable: 'USER'),
            string(credentialsId: 'INFA_PORT', variable: 'PORT'),
            string(credentialsId: 'INFA_TARGET', variable: 'TARGET'),
            sshUserPrivateKey(credentialsId: 'INFA_SSH', keyFileVariable: 'SSH_CRED')
        ]) {
            // 1) Préparer les fichiers côté Jenkins
            sh '''
                echo "🔧 Preparing backend build artefacts..."

                # On s'assure que dist existe (build déjà fait avant ce stage)
                ls -la ./api/dist || (echo "❌ ./api/dist not found" && exit 1)

                # On copie le .env backend dans dist (si tu en as besoin pour le runtime)
                chmod -R 777 ./api/ || true
                cp $ENV_FILE ./api/dist/.env

                echo "✅ Backend .env file copied to ./api/dist/.env"
            '''

            // 2) Copier les artefacts sur le serveur
            sh '''
                echo "📡 Copying artefacts to remote host $HOST..."

                # Code compilé dans dist
                scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT -r ./api/dist \
                    $USER@$HOST:/home/$USER/$TARGET/

                # Dossier prisma (schema + migrations) à la racine du projet déployé
                scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT -r ./api/prisma \
                    $USER@$HOST:/home/$USER/$TARGET/

                # prisma.config.ts à la racine du projet déployé
                scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT ./api/prisma.config.ts \
                    $USER@$HOST:/home/$USER/$TARGET/

                # docker-compose pour Postgres/Mongo dans dist (comme avant)
                scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT docker-compose.yml \
                    $USER@$HOST:/home/$USER/$TARGET/dist/

                # package.json + package-lock.json à la racine (pour npm ci)
                scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT ./api/package.json \
                    $USER@$HOST:/home/$USER/$TARGET/
                scp -o StrictHostKeyChecking=no -i $SSH_CRED -P $PORT ./api/package-lock.json \
                    $USER@$HOST:/home/$USER/$TARGET/
            '''

            // 3) Installer les dépendances et démarrer les conteneurs DB
            sh '''
                echo "🚀 Running npm ci and starting DB containers on remote..."

                ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "
                    set -eu
                    cd /home/$USER/$TARGET

                    echo '📦 Running npm ci (with devDependencies)...'
                    npm ci

                    cd /home/$USER/$TARGET/dist

                    echo '🌐 Creating Docker network if not exists...'
                    docker network create lxp_network || true

                    echo '🐳 Restarting docker compose stack...'
                    docker compose down || true
                    docker compose up -d
                "
            '''
        }
    }
}

        stage('Run Prisma migrations (DDL)') {
            steps {
                withCredentials([
                    string(credentialsId: 'INFA_MIGRATOR_PG_URL', variable: 'MIGRATOR_PG_URL'),
                    string(credentialsId: 'INFA_HOST', variable: 'HOST'),
                    string(credentialsId: 'INFA_USER', variable: 'USER'),
                    string(credentialsId: 'INFA_PORT', variable: 'PORT'),
                    string(credentialsId: 'INFA_TARGET', variable: 'TARGET'),
                    sshUserPrivateKey(credentialsId: 'INFA_SSH', keyFileVariable: 'SSH_CRED')
                ]) {

                sh '''
                    echo "🧬 Running Prisma migrations with DDL user..."

                    ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "
                        set -eu
                        cd /home/$USER/$TARGET

                        # On vérifie vite fait que prisma.config.ts et prisma/ sont bien là
                        echo '📂 Remote project layout:'
                        ls -la
                        ls -la prisma || (echo '❌ prisma/ directory missing' && exit 1)

                        echo '🏃 Running prisma migrate deploy with MIGRATOR_PG_URL...'
                        DATABASE_URL=\\"$MIGRATOR_PG_URL\\" npx prisma migrate deploy
                    "
            '''
        }
    }
}

        stage("Starting app") {
            steps {
                withCredentials([
                    file(credentialsId: 'INFA_ENV', variable: 'ENV_FILE'),
                    string(credentialsId: 'INFA_HOST', variable: 'HOST'),
                    string(credentialsId: 'INFA_USER', variable: 'USER'),
                    string(credentialsId: 'INFA_PORT', variable: 'PORT'),
                    string(credentialsId: 'INFA_TARGET', variable: 'TARGET'),
                    sshUserPrivateKey(credentialsId: 'FNP_SSH', keyFileVariable: 'SSH_CRED')
                ]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET/dist && npx prisma generate"
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "cd /home/$USER/$TARGET/dist/ && docker image prune -f"
                    '''

                    sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_CRED -p $PORT $USER@$HOST "pm2 restart /home/$USER/$TARGET/dist/src/server.js"
                    '''

                    echo "✅ Deployment to INFA completed successfully!"
                }
            }
        }
    }
}
